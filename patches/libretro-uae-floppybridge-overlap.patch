@@ -117,6 +117,20 @@ public:
 	// Reset this back to "empty"
 	virtual void reset(bool isHD) = 0;
 
+	// ADM: overlap search window. How far either side of the expected revolution point
+	// the extractor searches for the 1024-sequence overlap match, in sequences. The
+	// default is upstream's OVERLAP_SEQUENCE_MATCHES * (OVERLAP_EXTRA_BUFFER - 1) = 5120,
+	// sized for real-flux jitter and an arbitrary anchor; a driver whose anchor is a
+	// sync word knows its offset to within the pulse jitter and can set this small,
+	// which brings the revolution forward by the same number of sequences. A no-op
+	// for extractors that do not search.
+	virtual void setOverlapSearchWindow(uint32_t sequences) { (void)sequences; }
+	// ADM: overlap marker length, in sequences: how many sequences at the anchor are
+	// matched against the next lap. Upstream's OVERLAP_SEQUENCE_MATCHES = 1024 (~8 ms).
+	// A driver whose anchor is inside a sector header can match far fewer. A no-op for
+	// extractors that do not search.
+	virtual void setOverlapMatches(uint32_t sequences) { (void)sequences; }
+
 	// Submit a single sequence to the list - abstract function
 	virtual void submitSequence(const MFMSequenceInfo& sequence, bool isIndex, bool discardEarlySamples = true) = 0;
 
@@ -174,6 +188,17 @@ private:
 	uint32_t m_initialSequencesLength = 0;
 	// Where we're writing to as its a circular buffer
 	uint32_t m_initialSequencesWritePos = 0;
+	// ADM: overlap search window (see MFMExtractionTarget::setOverlapSearchWindow).
+	// Default = upstream's fixed window, so every existing driver behaves exactly as
+	// before. Bounded above by the m_initialSequences allocation.
+	uint32_t m_overlapSearchWindow = OVERLAP_SEQUENCE_MATCHES * (OVERLAP_EXTRA_BUFFER - 1);
+	// ADM: overlap marker length (see MFMExtractionTarget::setOverlapMatches). Default =
+	// upstream's. The IndexSequenceMarker array stays OVERLAP_SEQUENCE_MATCHES_INDEXMODE
+	// long and is always filled in full; only the first m_overlapMatches are compared.
+	uint32_t m_overlapMatches = OVERLAP_SEQUENCE_MATCHES;
+	// Sequences needed past the revolution point before a revolution is declared
+	// ready: the overlap marker plus the search window. Upstream: 1024 * 6 = 6144.
+	[[nodiscard]] uint32_t overlapSequences() const { return m_overlapMatches + m_overlapSearchWindow; }
 	// Sequences discovered around the index marker
 	IndexSequenceMarker m_indexSequence;
 
@@ -223,6 +248,23 @@ public:
 	// Sets the code so it always uses the index marker when finding revolutions
 	void setAlwaysUseIndex(bool useIndex) { m_useIndex = useIndex; }
 
+	// ADM: overlap search window, in sequences, clamped to [1, upstream's 5120]. Survives
+	// reset(): it is configuration, not per-revolution state.
+	virtual void setOverlapSearchWindow(uint32_t sequences) override {
+		const uint32_t maxWindow = OVERLAP_SEQUENCE_MATCHES * (OVERLAP_EXTRA_BUFFER - 1);
+		if (sequences < 1) sequences = 1;
+		if (sequences > maxWindow) sequences = maxWindow;
+		m_overlapSearchWindow = sequences;
+	}
+	[[nodiscard]] uint32_t overlapSearchWindow() const { return m_overlapSearchWindow; }
+	// ADM: overlap marker length, clamped to [64, upstream's 1024]. Survives reset().
+	virtual void setOverlapMatches(uint32_t sequences) override {
+		if (sequences < 64) sequences = 64;
+		if (sequences > OVERLAP_SEQUENCE_MATCHES) sequences = OVERLAP_SEQUENCE_MATCHES;
+		m_overlapMatches = sequences;
+	}
+	[[nodiscard]] uint32_t overlapMatches() const { return m_overlapMatches; }
+
 	// In simple mode, the rotation is matched purely on Index pulses alone, the data is not matched. Index mode must be enabled. This is fine for SCP reading etc
 	void setSimpleMode(bool simpleMode) { m_useSimpleMode = simpleMode; }
 
