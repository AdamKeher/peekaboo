-#define MAX_DISPLAYS 10
-struct MultiDisplay Displays[MAX_DISPLAYS];
+/* PEEKaboo: MAX_DISPLAYS is 1 in misc.h, which is what the declaration of this
+ * array uses; redefining it to 10 here made the two disagree. The trailing entry
+ * is the NULL terminator picasso96.c's `while (Displays[mon].monitorname)` walks
+ * to. retrodep/picasso_host.c fills entry 0 - target_get_display() and
+ * target_get_display_name() are already defined for __LIBRETRO__ above. */
+struct MultiDisplay Displays[MAX_DISPLAYS + 1];
 
+#ifndef __LIBRETRO__
