debug.c: extended memory watchpoint hit accessor

Generated from the inline patching that scripts/build_puae.ps1 and
scripts/build_puae.sh used to perform. Applies to libretro-uae
2b0ed42fe565fb997a0627aaa8f44e0948b527f8 in the order given by
patches/series.txt.

diff --git a/sources/src/debug.c b/sources/src/debug.c
index 315e96d..76c8e58 100644
--- a/sources/src/debug.c
+++ b/sources/src/debug.c
@@ -8947,4 +8947,23 @@ int adm_get_last_memwatch(uae_u32* pc, uae_u32* addr, uae_u32* val, int* rwi, in
     if (size) *size = adm_memwatch_hit_size;
     return 1;
 }
+#endif /* __LIBRETRO__ */
+/* ---- ADM memory watchpoint hit export (extended: access mask + register) ---- */
+#ifdef __LIBRETRO__
+extern uae_u32 adm_memwatch_hit_access_mask, adm_memwatch_hit_reg;
+int adm_get_last_memwatch2(uae_u32* pc, uae_u32* addr, uae_u32* val, int* rwi, int* size,
+                           uae_u32* access_mask, uae_u32* reg)
+{
+    if (!adm_memwatch_hit_valid)
+        return 0;
+    adm_memwatch_hit_valid = 0;
+    if (pc) *pc = adm_memwatch_hit_pc;
+    if (addr) *addr = adm_memwatch_hit_addr;
+    if (val) *val = adm_memwatch_hit_val;
+    if (rwi) *rwi = adm_memwatch_hit_rwi;
+    if (size) *size = adm_memwatch_hit_size;
+    if (access_mask) *access_mask = adm_memwatch_hit_access_mask;
+    if (reg) *reg = adm_memwatch_hit_reg;
+    return 1;
+}
 #endif /* __LIBRETRO__ */
