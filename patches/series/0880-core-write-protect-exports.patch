libretro-core.c: write-protect exports

Generated from the inline patching that scripts/build_puae.ps1 and
scripts/build_puae.sh used to perform. Applies to libretro-uae
2b0ed42fe565fb997a0627aaa8f44e0948b527f8 in the order given by
patches/series.txt.

diff --git a/libretro/libretro-core.c b/libretro/libretro-core.c
index 0bddc23..aa19388 100644
--- a/libretro/libretro-core.c
+++ b/libretro/libretro-core.c
@@ -10165,6 +10165,19 @@ RETRO_API int adm_shutdown_drive_bridges(void) {
 RETRO_API int adm_get_drive_bridge_status(int drive_idx, void* out) {
     return adm_bridge_get_status(drive_idx, (adm_bridge_status_t*)out);
 }
+// --- ADM per-drive floppy write protect ---
+// Thin wrappers over disk.c, which owns these because floppy[] is static there.
+extern int adm_floppy_set_write_protect(int drive_idx, int wp);
+extern int adm_floppy_get_write_protect(int drive_idx);
+
+RETRO_API int adm_set_floppy_write_protect(int drive_idx, int wp) {
+    return adm_floppy_set_write_protect(drive_idx, wp);
+}
+
+RETRO_API int adm_get_floppy_write_protect(int drive_idx) {
+    return adm_floppy_get_write_protect(drive_idx);
+}
