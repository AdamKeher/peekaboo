debug.c: console_out format-string safety

Generated from the inline patching that scripts/build_puae.ps1 and
scripts/build_puae.sh used to perform. Applies to libretro-uae
2b0ed42fe565fb997a0627aaa8f44e0948b527f8 in the order given by
patches/series.txt.

diff --git a/sources/src/debug.c b/sources/src/debug.c
index 27ac964..09ced1a 100644
--- a/sources/src/debug.c
+++ b/sources/src/debug.c
@@ -255,7 +255,7 @@ static const TCHAR help[] = {
 
 void debug_help (void)
 {
-	console_out (help);
+	console_out_f (_T("%s"), help);
 }
 
 
@@ -344,7 +344,7 @@ static int debug_out (const TCHAR *format, ...)
 	_vsntprintf (buffer, 4000 - 1, format, parms);
 	va_end (parms);
 
-	console_out (buffer);
+	console_out_f (_T("%s"), buffer);
 	if (debug_linecounter < MAX_LINECOUNTER)
 		debug_linecounter++;
 	if (debug_linecounter >= MAX_LINECOUNTER)
