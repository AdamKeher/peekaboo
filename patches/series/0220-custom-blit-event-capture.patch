custom.c: blit start event capture

Generated from the inline patching that scripts/build_puae.ps1 and
scripts/build_puae.sh used to perform. Applies to libretro-uae
2b0ed42fe565fb997a0627aaa8f44e0948b527f8 in the order given by
patches/series.txt.

diff --git a/sources/src/custom.c b/sources/src/custom.c
index b6322b5..96b1bc4 100644
--- a/sources/src/custom.c
+++ b/sources/src/custom.c
@@ -9990,6 +9990,8 @@ static void BLTDPTL(int hpos, uae_u16 v)
 	bltdpt = (bltdpt & ~0xffff) | (v & 0xfffe);
 }
 
+extern void adm_record_blit(uint16_t, uint16_t, uint32_t, uint32_t, uint32_t, uint32_t, uint16_t, uint16_t, uint16_t, uint16_t, uint16_t, uint16_t, uint16_t, uint16_t, uint16_t, uint16_t, uint16_t, uint16_t, uint16_t, uint16_t, uint8_t);
+/* ADM: capture blitter start events */
 static void BLTSIZE(int hpos, uae_u16 v)
 {
 	maybe_blit(hpos, 0);
@@ -10001,6 +10003,7 @@ static void BLTSIZE(int hpos, uae_u16 v)
 	if (!blt_info.hblitsize) {
 		blt_info.hblitsize = 64;
 	}
+	adm_record_blit((uint16_t)vpos, (uint16_t)current_hpos(), (uint32_t)bltapt, (uint32_t)bltbpt, (uint32_t)bltcpt, (uint32_t)bltdpt, bltcon0, bltcon1, 0, (uint16_t)blt_info.vblitsize, (uint16_t)blt_info.hblitsize, blt_info.bltafwm, blt_info.bltalwm, (uint16_t)(uae_u16)blt_info.bltamod, (uint16_t)(uae_u16)blt_info.bltbmod, (uint16_t)(uae_u16)blt_info.bltcmod, (uint16_t)(uae_u16)blt_info.bltdmod, blt_info.bltadat, blt_info.bltbdat, blt_info.bltcdat, (uint8_t)copper_access);
 	do_blitter(hpos, copper_access, copper_access ? cop_state.ip : M68K_GETPC);
 	dcheck_is_blit_dangerous();
 }
@@ -10030,6 +10033,7 @@ static void BLTSIZH(int hpos, uae_u16 v)
 	if (!blt_info.hblitsize) {
 		blt_info.hblitsize = 0x0800;
 	}
+	adm_record_blit((uint16_t)vpos, (uint16_t)current_hpos(), (uint32_t)bltapt, (uint32_t)bltbpt, (uint32_t)bltcpt, (uint32_t)bltdpt, bltcon0, bltcon1, 0, (uint16_t)blt_info.vblitsize, (uint16_t)blt_info.hblitsize, blt_info.bltafwm, blt_info.bltalwm, (uint16_t)(uae_u16)blt_info.bltamod, (uint16_t)(uae_u16)blt_info.bltbmod, (uint16_t)(uae_u16)blt_info.bltcmod, (uint16_t)(uae_u16)blt_info.bltdmod, blt_info.bltadat, blt_info.bltbdat, blt_info.bltcdat, (uint8_t)copper_access);
 	do_blitter(hpos, copper_access, copper_access ? cop_state.ip : M68K_GETPC);
 	dcheck_is_blit_dangerous();
 }
