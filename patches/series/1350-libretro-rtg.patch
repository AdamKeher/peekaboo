+/* PEEKaboo: RTG state, for a host that has to know whether the picture on screen
+ * came from the chipset or from a Picasso96 screen. Every raster overlay - copper,
+ * DMA, blitter, sprites - maps a beam position onto the frame, and an RTG frame
+ * has no beam, so the host switches them off while this says the display is RTG.
+ *
+ * board_size is the configured uaegfx VRAM in bytes (0 when there is no board, so
+ * it doubles as "is RTG available at all"); width/height/depth describe the screen
+ * the guest last opened, and are 0 while the chipset display is up. */
+RETRO_API void adm_get_rtg_state(uint32_t* board_size, uint32_t* width, uint32_t* height,
+                                 uint32_t* depth, uint8_t* active) {
+#ifdef PICASSO96
+    struct picasso96_state_struct* state = &picasso96_state[0];
+    int on = picasso_host_active();
+    if (board_size) *board_size = (uint32_t)currprefs.rtgboards[0].rtgmem_size;
+    if (width)      *width      = on ? (uint32_t)picasso_host_width() : 0;
+    if (height)     *height     = on ? (uint32_t)picasso_host_height() : 0;
+    /* The guest's depth, not the host's: a 256-colour Workbench is 8 here even
+     * though the core hands the front-end 16- or 32-bit pixels. */
+    if (depth)      *depth      = on ? (uint32_t)(state->BytesPerPixel * 8) : 0;
+    if (active)     *active     = on ? 1 : 0;
+#else
+    if (board_size) *board_size = 0;
+    if (width)      *width      = 0;
+    if (height)     *height     = 0;
+    if (depth)      *depth      = 0;
+    if (active)     *active     = 0;
+#endif
+}
