+#ifdef __LIBRETRO__
+/* ADM bounded one-shot status: 0 idle, 1 armed, 2 hit, 3 budget expired, 4 cancelled. */
+int adm_oneshot_status = 0;
+uint32_t adm_oneshot_target_pc = 0;
+uint32_t adm_oneshot_stop_pc = 0;
+uint32_t adm_oneshot_budget = 0;
+uint32_t adm_oneshot_executed = 0;
+int adm_oneshot_check(uint32_t pc) {
+	if (adm_oneshot_status != 1) return 0;
+	adm_oneshot_stop_pc = pc;
+	adm_oneshot_executed++;
+	if (pc == adm_oneshot_target_pc) {
+		adm_oneshot_status = 2;
+		return 1;
+	}
+	if (adm_oneshot_executed >= adm_oneshot_budget) {
+		adm_oneshot_status = 3;
+		return 1;
+	}
+	return 0;
+}
+#endif
