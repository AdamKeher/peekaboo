debug.c: breakpoint trace arming + libretro early return

Generated from the inline patching that scripts/build_puae.ps1 and
scripts/build_puae.sh used to perform. Applies to libretro-uae
2b0ed42fe565fb997a0627aaa8f44e0948b527f8 in the order given by
patches/series.txt.

diff --git a/sources/src/debug.c b/sources/src/debug.c
index 09ced1a..e049f4f 100644
--- a/sources/src/debug.c
+++ b/sources/src/debug.c
@@ -7192,8 +7192,36 @@ static bool debug_line (TCHAR *input)
 
 static TCHAR input[MAX_LINEWIDTH];
 
+#ifdef __LIBRETRO__
+int adm_debug_break_pending = 0;
+int adm_skip_bp_check = 0;
+void adm_arm_breakpoint_trace(void) {
+	int have_bp = 0, i;
+	for (i = 0; i < BREAKPOINT_TOTAL; i++) {
+		if (bpnodes[i].enabled) { have_bp = 1; break; }
+	}
+	if (have_bp || trace_mode) {
+		int step_mode = (trace_mode != 0);
+		if (!trace_mode)
+			trace_mode = TRACE_CHECKONLY;
+		debugging = -1;
+		set_special (SPCFLAG_BRK);
+		if (step_mode)
+			adm_skip_bp_check = 1;
+	}
+}
+#endif
 static void debug_1 (void)
 {
+#ifdef __LIBRETRO__
+	{
+		extern bool libretro_frame_end;
+		adm_debug_break_pending = 1;
+		trace_mode = 0;
+		libretro_frame_end = true;
+		return;
+	}
+#endif
 	open_console();
 	custom_dumpstate(0);
 	m68k_dumpstate(&nextpc, debug_pc);
