+/* fill_rx() for the UART's per-byte poll: skipped while the last few came back empty. After a
+ * read that found data the very next empty poll goes straight to the source again, so a
+ * stream longer than rx_buf keeps flowing at full rate. */
+static void fill_rx_for_uart(void)
+{
+   if (rx_pos < rx_len)
+      return;
+   if (++rx_idle_polls < RX_IDLE_POLL_EVERY)
+      return;
+   rx_idle_polls = 0;
+   fill_rx();
+   if (rx_pos < rx_len)
+      rx_idle_polls = RX_IDLE_POLL_EVERY;
+}
