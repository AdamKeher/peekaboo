+/* Give back every SysEx buffer the driver has finished with. Never waits: a buffer still
+ * playing stays busy until a later call finds it done. With `force`, after midiOutReset() has
+ * returned them all, the done flag is not consulted. */
+static void midi_sysex_reclaim(bool force)
+{
+   for (int i = 0; i < MIDI_SYSEX_SLOTS; i++)
+   {
+      if (!midi_sysex_busy[i])
+         continue;
+      if (!force && !(midi_sysex_hdr[i].dwFlags & MHDR_DONE))
+         continue;
+      if (midi_out &&
+          midiOutUnprepareHeader(midi_out, &midi_sysex_hdr[i], sizeof(MIDIHDR)) == MIDIERR_STILLPLAYING)
+         continue;
+      midi_sysex_busy[i] = false;
+   }
+}
