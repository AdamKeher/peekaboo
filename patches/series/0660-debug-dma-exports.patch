+
+/* ---- ADM DMA Stats Exports ---- */
+#ifdef __LIBRETRO__
+
+int adm_get_dma_record(void** out_ptr, int* out_hpos_count, int* out_vpos_count)
+{
+    if (!debug_dma || !dma_record[0] || !dma_record[1]) {
+        if (out_ptr)
+            *out_ptr = NULL;
+        if (out_hpos_count)
+            *out_hpos_count = 0;
+        if (out_vpos_count)
+            *out_vpos_count = 0;
+        return 0;
+    }
+    int completed = dma_record_toggle ^ 1;
+    if (out_ptr)
+        *out_ptr = dma_record[completed];
+    if (out_hpos_count)
+        *out_hpos_count = NR_DMA_REC_HPOS;
+    if (out_vpos_count)
+        *out_vpos_count = NR_DMA_REC_VPOS;
+    return NR_DMA_REC_HPOS * NR_DMA_REC_VPOS;
+}
+
+/* Live (in-progress) frame's dma_record — the buffer currently being filled. Used while
+   paused at a mid-frame breakpoint so the scrubber shows the partial frame's DMA up to the
+   break. Slots past the break are cleared (record_dma_reset clears the new buffer at frame
+   start), so they read as "no DMA", which the host dims as not-yet-executed. */
+int adm_get_dma_record_live(void** out_ptr, int* out_hpos_count, int* out_vpos_count)
+{
+    if (!debug_dma || !dma_record[0] || !dma_record[1]) {
+        if (out_ptr)
+            *out_ptr = NULL;
+        if (out_hpos_count)
+            *out_hpos_count = 0;
+        if (out_vpos_count)
+            *out_vpos_count = 0;
+        return 0;
+    }
+    if (out_ptr)
+        *out_ptr = dma_record[dma_record_toggle];
+    if (out_hpos_count)
+        *out_hpos_count = NR_DMA_REC_HPOS;
+    if (out_vpos_count)
+        *out_vpos_count = NR_DMA_REC_VPOS;
+    return NR_DMA_REC_HPOS * NR_DMA_REC_VPOS;
+}
+
+void adm_set_debug_dma(int mode)
+{
+    debug_dma = mode;
+    if (mode && !dma_record[0]) {
+        record_dma_reset(0);
+    }
+}
+
+int adm_get_debug_dma(void) { return debug_dma; }
+
+#endif /* __LIBRETRO__ */
