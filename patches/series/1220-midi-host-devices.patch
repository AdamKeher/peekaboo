 /* ------------------------------------------------------------------------------------- */
+/* MIDI                                                                                   */
+/* ------------------------------------------------------------------------------------- */
+
+/* The Amiga has no MIDI port: MIDI interfaces hang off the serial port, and software sets
+ * the UART to 31250 baud (SERPER's table rounds it to 31400). At that rate the byte stream
+ * goes to the host MIDI devices instead of the serial target, as WinUAE does. */
+
+static bool midi_ready;
+
+#ifdef _WIN32
+static HMIDIOUT midi_out;
+static HMIDIIN midi_in;
+
+/* Outgoing parser: running status, channel and system common lengths, SysEx buffered. */
+static unsigned char midi_msg[3];
+static int midi_msg_len, midi_msg_need;
+static unsigned char midi_running_status;
+static unsigned char midi_sysex[65536];
+static int midi_sysex_len;
+static bool midi_in_sysex;
+
+/* Incoming bytes, filled by the winmm callback thread, drained by the UART. Single writer,
+ * single reader. */
+static unsigned char midi_in_ring[8192];
+static volatile unsigned midi_in_head, midi_in_tail;
+
+static void midi_in_push(unsigned char b)
+{
+   unsigned next = (midi_in_head + 1) & (sizeof(midi_in_ring) - 1);
+   if (next == midi_in_tail)
+      return; /* full: drop */
+   midi_in_ring[midi_in_head] = b;
+   midi_in_head = next;
+   st.midi_in_bytes++;
+}
+
+static MIDIHDR midi_in_header;
+static char midi_in_buffer[4096];
+
+static void CALLBACK midi_in_callback(HMIDIIN h, UINT msg, DWORD_PTR instance, DWORD_PTR p1,
+                                      DWORD_PTR p2)
+{
+   (void)h;
+   (void)instance;
+   (void)p2;
+   if (msg == MIM_DATA)
+   {
+      unsigned char status = (unsigned char)(p1 & 0xff);
+      int len = 3;
+      if (status >= 0xf8 || status == 0xf6)
+         len = 1;
+      else if ((status & 0xf0) == 0xc0 || (status & 0xf0) == 0xd0 || status == 0xf1 ||
+               status == 0xf3)
+         len = 2;
+      for (int i = 0; i < len; i++)
+         midi_in_push((unsigned char)((p1 >> (8 * i)) & 0xff));
+   }
+   else if (msg == MIM_LONGDATA)
+   {
+      MIDIHDR *hdr = (MIDIHDR *)p1;
+      for (DWORD i = 0; i < hdr->dwBytesRecorded; i++)
+         midi_in_push((unsigned char)hdr->lpData[i]);
+      /* Hand the buffer back for the next SysEx, unless the device is closing. */
+      if (midi_in && hdr->dwBytesRecorded)
+         midiInAddBuffer(midi_in, hdr, sizeof(*hdr));
+   }
+}
+
+static void midi_send_short(void)
+{
+   DWORD packed = midi_msg[0] | ((DWORD)midi_msg[1] << 8) | ((DWORD)midi_msg[2] << 16);
+   if (midi_out && midiOutShortMsg(midi_out, packed) == MMSYSERR_NOERROR)
+      st.midi_out_messages++;
+}
+
+static void midi_send_sysex(void)
+{
+   if (!midi_out || midi_sysex_len <= 0)
+      return;
+   MIDIHDR hdr;
+   memset(&hdr, 0, sizeof(hdr));
+   hdr.lpData = (LPSTR)midi_sysex;
+   hdr.dwBufferLength = (DWORD)midi_sysex_len;
+   hdr.dwBytesRecorded = (DWORD)midi_sysex_len;
+   if (midiOutPrepareHeader(midi_out, &hdr, sizeof(hdr)) == MMSYSERR_NOERROR)
+   {
+      if (midiOutLongMsg(midi_out, &hdr, sizeof(hdr)) == MMSYSERR_NOERROR)
+         st.midi_out_messages++;
+      /* Unprepare returns MIDIERR_STILLPLAYING until the driver has taken the buffer. */
+      for (int tries = 0; tries < 100; tries++)
+      {
+         if (midiOutUnprepareHeader(midi_out, &hdr, sizeof(hdr)) != MIDIERR_STILLPLAYING)
+            break;
+         Sleep(1);
+      }
+   }
+}
+
+static void midi_write(unsigned char b)
+{
+   if (b >= 0xf8)
+   {
+      /* Real-time bytes may appear anywhere, even inside SysEx, and stand alone. */
+      if (midi_out && midiOutShortMsg(midi_out, b) == MMSYSERR_NOERROR)
+         st.midi_out_messages++;
+      return;
+   }
+   if (midi_in_sysex)
+   {
+      if (midi_sysex_len < (int)sizeof(midi_sysex))
+         midi_sysex[midi_sysex_len++] = b;
+      if (b == 0xf7)
+      {
+         midi_send_sysex();
+         midi_in_sysex = false;
+         midi_sysex_len = 0;
+      }
+      return;
+   }
+   if (b == 0xf0)
+   {
+      midi_in_sysex = true;
+      midi_sysex_len = 0;
+      midi_sysex[midi_sysex_len++] = b;
+      midi_running_status = 0;
+      return;
+   }
+   if (b & 0x80)
+   {
+      midi_msg[0] = b;
+      midi_msg[1] = midi_msg[2] = 0;
+      midi_msg_len = 1;
+      if (b >= 0xf0)
+      {
+         midi_running_status = 0;
+         midi_msg_need = (b == 0xf2) ? 3 : (b == 0xf1 || b == 0xf3) ? 2 : 1;
+      }
+      else
+      {
+         midi_running_status = b;
+         midi_msg_need = ((b & 0xf0) == 0xc0 || (b & 0xf0) == 0xd0) ? 2 : 3;
+      }
+   }
+   else
+   {
+      if (midi_msg_len == 0)
+      {
+         if (!midi_running_status)
+            return; /* a data byte with no status: nothing to attach it to */
+         midi_msg[0] = midi_running_status;
+         midi_msg_len = 1;
+         midi_msg_need = ((midi_running_status & 0xf0) == 0xc0 ||
+                          (midi_running_status & 0xf0) == 0xd0) ? 2 : 3;
+      }
+      if (midi_msg_len < 3)
+         midi_msg[midi_msg_len++] = b;
+   }
+   if (midi_msg_len >= midi_msg_need)
+   {
+      midi_send_short();
+      midi_msg_len = 0;
+   }
+}
+
+static void midi_close(void)
+{
+   if (midi_in)
+   {
+      HMIDIIN h = midi_in;
+      midiInStop(h);
+      midiInReset(h);
+      midi_in = NULL;
+      midiInUnprepareHeader(h, &midi_in_header, sizeof(midi_in_header));
+      midiInClose(h);
+   }
+   if (midi_out)
+   {
+      midiOutReset(midi_out);
+      midiOutClose(midi_out);
+      midi_out = NULL;
+   }
+   if (midi_ready)
+      write_log("MIDI: closed\n");
+   midi_ready = false;
+   midi_msg_len = 0;
+   midi_running_status = 0;
+   midi_in_sysex = false;
+   midi_in_head = midi_in_tail = 0;
+   st.midi_active = 0;
+}
+
+static void midi_open(void)
+{
+   midi_close();
+   st.midi_error[0] = 0;
+   if (st.midi_out_device >= -1)
+   {
+      UINT id = st.midi_out_device == -1 ? MIDI_MAPPER : (UINT)st.midi_out_device;
+      MMRESULT r = midiOutOpen(&midi_out, id, 0, 0, CALLBACK_NULL);
+      if (r != MMSYSERR_NOERROR)
+      {
+         midi_out = NULL;
+         snprintf(st.midi_error, sizeof(st.midi_error), "cannot open MIDI out %d (error %u)",
+                  (int)st.midi_out_device, (unsigned)r);
+      }
+   }
+   if (st.midi_in_device >= 0)
+   {
+      MMRESULT r = midiInOpen(&midi_in, (UINT)st.midi_in_device, (DWORD_PTR)midi_in_callback, 0,
+                              CALLBACK_FUNCTION);
+      if (r == MMSYSERR_NOERROR)
+      {
+         memset(&midi_in_header, 0, sizeof(midi_in_header));
+         midi_in_header.lpData = midi_in_buffer;
+         midi_in_header.dwBufferLength = sizeof(midi_in_buffer);
+         midiInPrepareHeader(midi_in, &midi_in_header, sizeof(midi_in_header));
+         midiInAddBuffer(midi_in, &midi_in_header, sizeof(midi_in_header));
+         midiInStart(midi_in);
+      }
+      else
+      {
+         midi_in = NULL;
+         snprintf(st.midi_error, sizeof(st.midi_error), "cannot open MIDI in %d (error %u)",
+                  (int)st.midi_in_device, (unsigned)r);
+      }
+   }
+   midi_ready = midi_out != NULL || midi_in != NULL;
+   st.midi_active = midi_ready ? 1 : 0;
+   if (midi_ready)
+      write_log("MIDI: open (out %d, in %d)\n", (int)st.midi_out_device, (int)st.midi_in_device);
+}
+
+static int midi_read_avail(void)
+{
+   return (int)((midi_in_head - midi_in_tail) & (sizeof(midi_in_ring) - 1));
+}
+
+static int midi_read(void)
+{
+   if (midi_in_head == midi_in_tail)
+      return -1;
+   int b = midi_in_ring[midi_in_tail];
+   midi_in_tail = (midi_in_tail + 1) & (sizeof(midi_in_ring) - 1);
+   return b;
+}
+#else
+/* MIDI needs CoreMIDI or ALSA here, neither of which this build links. */
+static void midi_close(void)
+{
+   midi_ready = false;
+   st.midi_active = 0;
+}
+
+static void midi_open(void)
+{
+   snprintf(st.midi_error, sizeof(st.midi_error), "MIDI is only implemented on Windows");
+}
+
+static void midi_write(unsigned char b)
+{
+   (void)b;
+}
+
+static int midi_read_avail(void)
+{
+   return 0;
+}
+
+static int midi_read(void)
+{
+   return -1;
+}
+#endif
+
+static bool midi_wanted(void)
+{
+   return st.midi_out_device >= -1 || st.midi_in_device >= 0;
+}
