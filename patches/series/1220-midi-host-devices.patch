+/* The host MIDI devices the serial port uses at MIDI speed: out -2 none, -1 the system
+ * mapper, 0.. a device; in -1 none, 0.. a device. */
+int adm_midi_set_devices(int out_device, int in_device)
+{
+   midi_request_out = out_device < -2 ? -2 : out_device;
+   midi_request_in = in_device < -1 ? -1 : in_device;
+   midi_request_seen = true;
+   midi_request_pending = 1;
+   return 1;
+}
+
+/* For libretro-core.c, which mirrors them into currprefs.win32_midi*dev so serial_open()
+ * knows an empty serial port still has somewhere to send bytes. Returns 1 when a request
+ * was waiting. */
+int adm_hostio_take_midi_request(int *out_device, int *in_device)
+{
+   *out_device = midi_request_out;
+   *in_device = midi_request_in;
+   if (!midi_request_pending)
+      return 0;
+   midi_request_pending = 0;
+   return 1;
+}
+
+int adm_hostio_midi_request_seen(void)
+{
+   return midi_request_seen ? 1 : 0;
+}
+
+/* After libretro-core.c re-opened the port for new MIDI devices: take them, and if the UART
+ * is already at MIDI speed open them now rather than waiting for the next SERPER write. */
+void adm_hostio_apply_midi(int out_device, int in_device)
+{
+   st.midi_out_device = out_device;
+   st.midi_in_device = in_device;
+   midi_close();
+   if (st.serial_baud == 31400 && midi_wanted())
+      midi_open();
+}
