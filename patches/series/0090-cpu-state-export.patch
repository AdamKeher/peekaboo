+// --- Amiga Disk Manager custom exports ---
+#ifndef UAE_NEWCPU_H
+#include "newcpu.h"
+#endif
+
+RETRO_API void adm_get_cpu_state(uint32_t* regs_out, uint32_t* pc, uint16_t* sr) {
+    if (regs_out) {
+        for (int i=0; i<16; i++) {
+            regs_out[i] = regs.regs[i];
+        }
+    }
+    if (pc) *pc = m68k_getpc();
+    if (sr) {
+        MakeSR();
+        *sr = regs.sr;
+    }
