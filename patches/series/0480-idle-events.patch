+
+// --- Bartman idle-time profiling (debug_start_idle / debug_stop_idle) ---
+// Populated from adm_uaelib_gate() (uaelib fn 88, barto_cmd_set_idle). Each event stamps the
+// beam position (vpos/hpos) so the host can position idle spans on the frame scrubber exactly
+// like copper/blit/CPU rows (lRef = vpos*CCKPerLine + hpos). The absolute CCK is kept too so the
+// host can window-filter events to the displayed frame.
+#ifndef ADM_MAX_IDLE_EVENTS
+#define ADM_MAX_IDLE_EVENTS 256
+#endif
+typedef struct {
+    uint32_t cycle;  /* absolute CCK at the call (get_cycles()/512), for frame windowing */
+    uint16_t vpos;   /* scanline at the call */
+    uint16_t hpos;   /* horizontal CCK at the call */
+    uint8_t  start;  /* 1 = start idle, 0 = stop idle */
+    uint8_t  pad[3];
+} adm_idle_event_t;
+
+static adm_idle_event_t adm_idle_events[ADM_MAX_IDLE_EVENTS];
+static uint32_t adm_idle_write_pos = 0;
+
+/* Called from adm_uaelib_gate() when barto_cmd == barto_cmd_set_idle. */
+void adm_record_idle(int start) {
+    uint32_t idx = adm_idle_write_pos % ADM_MAX_IDLE_EVENTS;
+    adm_idle_events[idx].cycle = (uint32_t)(get_cycles() / 512);
+    adm_idle_events[idx].vpos  = (uint16_t)vpos;
+    adm_idle_events[idx].hpos  = (uint16_t)current_hpos();
+    adm_idle_events[idx].start = (uint8_t)(start ? 1 : 0);
+    adm_idle_events[idx].pad[0] = adm_idle_events[idx].pad[1] = adm_idle_events[idx].pad[2] = 0;
+    adm_idle_write_pos++;
+}
+
+RETRO_API int adm_get_idle_events(adm_idle_event_t* out, int max) {
+    return adm_ring_copy(adm_idle_events, ADM_MAX_IDLE_EVENTS,
+                         adm_idle_write_pos, out, max,
+                         sizeof(adm_idle_event_t), NULL);
+}
+
+RETRO_API void adm_clear_idle_events(void) {
+    adm_idle_write_pos = 0;
 }
