 static struct cputbl_data cpudatatbl[65536];
+/* ADM: per-instruction CPU trace capture helper (called from m68k_run_1/1_ce) */
+extern int adm_cpu_trace_enabled;
+extern void adm_record_cpu_trace(uint16_t, uint16_t, uint32_t, const uint8_t*, uint8_t, const uint32_t*, uint16_t);
+static void adm_cpu_trace_pre(struct regstruct *r) {
+	int adm_i, adm_wlen;
+	uint8_t adm_raw[10];
+	if (!adm_cpu_trace_enabled) return;
+	adm_wlen = (int)cpudatatbl[r->opcode].length;
+	if (adm_wlen < 1) adm_wlen = 1;
+	if (adm_wlen > 5) adm_wlen = 5;
+	adm_raw[0] = (uint8_t)(r->opcode >> 8);
+	adm_raw[1] = (uint8_t)(r->opcode & 0xFF);
+	for (adm_i = 1; adm_i < adm_wlen; adm_i++) {
+		uae_u16 adm_w = get_word(r->instruction_pc + (uaecptr)(adm_i * 2));
+		adm_raw[adm_i * 2] = (uint8_t)(adm_w >> 8);
+		adm_raw[adm_i * 2 + 1] = (uint8_t)(adm_w & 0xFF);
+	}
+	MakeSR();
+	adm_record_cpu_trace((uint16_t)vpos, (uint16_t)current_hpos(), (uint32_t)r->instruction_pc, adm_raw, (uint8_t)(adm_wlen * 2), r->regs, regs.sr);
+}
 
 struct mmufixup mmufixup[2];
 
