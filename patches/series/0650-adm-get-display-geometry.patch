+/* adm_get_display_geometry — export PUAE frame/crop state for overlay coordinate mapping.
+ * full_w/full_h : full native frame dimensions (retrow x retroh, e.g. 720x287 for PAL hires)
+ * crop_x/crop_y : pixels cropped from left/top before handing to video callback (retrox_crop, retroy_crop)
+ * vlb           : visible_left_border — horizontal pixel offset baked into the frame buffer by UAE drawing
+ * ya            : thisframe_y_adjust  — first Amiga scanline rendered in the frame buffer
+ */
+RETRO_API void adm_get_display_geometry(int* full_w, int* full_h,
+                                         int* crop_x, int* crop_y,
+                                         int* vlb, int* ya) {
+    if (full_w) *full_w = (int)retrow;
+    if (full_h) *full_h = (int)retroh;
+    if (crop_x) *crop_x = (int)retrox_crop;
+    if (crop_y) *crop_y = (int)retroy_crop;
+    if (vlb)    *vlb    = visible_left_border;
+    if (ya)     *ya     = thisframe_y_adjust;
+}
