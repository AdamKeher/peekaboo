uaelib.c: Bartman uaelib function 88

Generated from the inline patching that scripts/build_puae.ps1 and
scripts/build_puae.sh used to perform. Applies to libretro-uae
2b0ed42fe565fb997a0627aaa8f44e0948b527f8 in the order given by
patches/series.txt.

diff --git a/sources/src/uaelib.c b/sources/src/uaelib.c
index 49fb7c2..38fc0c1 100644
--- a/sources/src/uaelib.c
+++ b/sources/src/uaelib.c
@@ -414,6 +414,42 @@ static uae_u32 uaelib_demux_common(TrapContext *ctx, uae_u32 ARG0, uae_u32 ARG1,
 			return d0;
 		}
 
+#ifdef __LIBRETRO__
+		/* ADM: Bartman (vscode-amiga-debug) debug gateway. The Amiga-side
+		   debug_*() helpers call UaeLib(88, barto_cmd, arg, ...). ARG1 is the
+		   barto command, ARG2 is a pointer to a (transient, stack-allocated)
+		   debug_resource struct for register, or the address for unregister. */
+		case 88:
+			if (ctx) {
+				extern void adm_debug_register_resource(uint32_t, uint32_t, const char*, uint16_t, uint16_t, int16_t, int16_t, int16_t, int16_t);
+				extern void adm_debug_unregister_resource(uint32_t);
+				extern void adm_record_idle(int);
+				uae_u32 barto_cmd = ARG1;
+				uae_u32 arg = ARG2;
+				if (barto_cmd == 4 /* barto_cmd_register_resource */) {
+					char nm[33];
+					int ci;
+					uae_u32 address = trap_get_long(ctx, arg + 0);
+					uae_u32 size    = trap_get_long(ctx, arg + 4);
+					uae_u16 rtype   = trap_get_word(ctx, arg + 40);
+					uae_u16 rflags  = trap_get_word(ctx, arg + 42);
+					uae_s16 w       = (uae_s16)trap_get_word(ctx, arg + 44);
+					uae_s16 h       = (uae_s16)trap_get_word(ctx, arg + 46);
+					uae_s16 np      = (uae_s16)trap_get_word(ctx, arg + 48);
+					for (ci = 0; ci < 32; ci++)
+						nm[ci] = (char)trap_get_byte(ctx, arg + 8 + ci);
+					nm[32] = 0;
+					/* width field (offset 44) doubles as palette numEntries */
+					adm_debug_register_resource(address, size, nm, rtype, rflags, w, h, np, w);
+				} else if (barto_cmd == 5 /* barto_cmd_set_idle */) {
+					adm_record_idle((int)arg);
+				} else if (barto_cmd == 6 /* barto_cmd_unregister_resource */) {
+					adm_debug_unregister_resource(arg);
+				}
+			}
+			return 0;
+#endif
+
 	}
 	return 0;
 }
