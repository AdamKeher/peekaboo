libretro-core.c: adm_assemble()

Generated from the inline patching that scripts/build_puae.ps1 and
scripts/build_puae.sh used to perform. Applies to libretro-uae
2b0ed42fe565fb997a0627aaa8f44e0948b527f8 in the order given by
patches/series.txt.

diff --git a/libretro/libretro-core.c b/libretro/libretro-core.c
index 6bd8380..9c14d3a 100644
--- a/libretro/libretro-core.c
+++ b/libretro/libretro-core.c
@@ -8951,4 +8951,22 @@ RETRO_API uint32_t adm_disasm_one(uint32_t pc, char* mnemoBuf, int mnemoSize,
         hexBuf[hexSize - 1] = '\0';
     }
     return (uint32_t)nextpc;
+}
+/* TCHAR == char in the libretro build; m68k_asm takes a non-const line
+   (it strips/upcases into a local copy), hence the local buffer. */
+extern int m68k_asm(char *sline, uae_u16 *out, uaecptr pc);
+
+RETRO_API int adm_asm_one(const char* src, uint32_t pc, uint16_t* outWords, int maxWords) {
+    char buf[256];
+    uae_u16 words[16];
+    int n, i;
+    if (!src)
+        return 0;
+    snprintf(buf, sizeof(buf), "%s", src);
+    n = m68k_asm(buf, words, (uaecptr)pc);
+    if (n > 0 && outWords) {
+        for (i = 0; i < n && i < maxWords; i++)
+            outWords[i] = words[i];
+    }
+    return n; /* >0 word count, 0 syntax error, -1 line too long */
 }
