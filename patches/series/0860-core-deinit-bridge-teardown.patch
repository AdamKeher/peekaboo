libretro-core.c: retro_deinit() stops live floppy drives

Generated from the inline patching that scripts/build_puae.ps1 and
scripts/build_puae.sh used to perform. Applies to libretro-uae
2b0ed42fe565fb997a0627aaa8f44e0948b527f8 in the order given by
patches/series.txt.

diff --git a/libretro/libretro-core.c b/libretro/libretro-core.c
index 2ce9a24..0bddc23 100644
--- a/libretro/libretro-core.c
+++ b/libretro/libretro-core.c
@@ -5132,6 +5132,20 @@ void retro_init(void)
 
 void retro_deinit(void)
 {
+   /* ADM: stop every live floppy drive FIRST. Each FloppyBridge driver owns a
+      worker thread and an open serial port, and nothing in UAE's own teardown
+      releases either - DISK_free() only closes backing files. Without this the
+      motor keeps spinning and the head keeps stepping after the machine has
+      stopped, and the orphan thread outlives the host's FreeLibrary() to wedge
+      the next core load. The host calls the export too; this is the backstop,
+      and adm_bridge_shutdown_all() is idempotent. Declared locally because
+      disk.c is a C++ translation unit whose ADM entry points live inside its
+      extern "C" block, and this call sits above their wrappers in this file. */
+   {
+      extern int adm_bridge_shutdown_all(void);
+      adm_bridge_shutdown_all();
+   }
+
    if (save_state_file_size)
       leave_program();
 
