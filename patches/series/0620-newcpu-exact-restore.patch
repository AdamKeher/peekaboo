newcpu.c: exact state restore flag and guard

Generated from the inline patching that scripts/build_puae.ps1 and
scripts/build_puae.sh used to perform. Applies to libretro-uae
2b0ed42fe565fb997a0627aaa8f44e0948b527f8 in the order given by
patches/series.txt.

diff --git a/sources/src/newcpu.c b/sources/src/newcpu.c
index 114f380..61fc337 100644
--- a/sources/src/newcpu.c
+++ b/sources/src/newcpu.c
@@ -6788,6 +6788,11 @@ static void m68k_run_mmu (void)
 #endif /* CPUEMU_0 */
 
 int in_m68k_go = 0;
+#ifdef __LIBRETRO__
+/* When set, m68k_go() returns right after a savestate restore preamble, before
+ * executing any instructions, so a debugger snapshot resumes at the exact saved PC. */
+int adm_restore_no_run = 0;
+#endif
 
 #if 0
 static void exception2_handle (uaecptr addr, uaecptr fault)
@@ -7046,6 +7051,15 @@ void m68k_go (int may_quit)
 		if (restored) {
 			restored = 0;
 			savestate_restore_final();
+#ifdef __LIBRETRO__
+			/* Debugger exact restore: full machine state is loaded and PC is set, so
+			 * return before run_func() executes and resume at the saved PC instead of
+			 * advancing ~1 frame. */
+			if (adm_restore_no_run) {
+				adm_restore_no_run = 0;
+				return 0;
+			}
+#endif
 		}
 #endif
 
