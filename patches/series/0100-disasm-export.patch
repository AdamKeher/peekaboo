libretro-core.c: adm_disassemble()

Generated from the inline patching that scripts/build_puae.ps1 and
scripts/build_puae.sh used to perform. Applies to libretro-uae
2b0ed42fe565fb997a0627aaa8f44e0948b527f8 in the order given by
patches/series.txt.

diff --git a/libretro/libretro-core.c b/libretro/libretro-core.c
index 1d93c54..6bd8380 100644
--- a/libretro/libretro-core.c
+++ b/libretro/libretro-core.c
@@ -8929,4 +8929,26 @@ RETRO_API void adm_get_cpu_state(uint32_t* regs_out, uint32_t* pc, uint16_t* sr)
         MakeSR();
         *sr = regs.sr;
     }
+}
+/* Forward-declare only what we need — the full disasm.h pulls in
+   types (amodes, wordsizes, struct cpum2c) that are unavailable in
+   this translation unit and cause build failures on macOS/Clang. */
+extern void sm68k_disasm(char *instrname, char *instrcode,
+                         uaecptr addr, uaecptr *nextpc, uaecptr lastpc);
+
+RETRO_API uint32_t adm_disasm_one(uint32_t pc, char* mnemoBuf, int mnemoSize,
+                                   char* hexBuf, int hexSize) {
+    char instrname[512] = "";
+    char instrcode[128] = "";
+    uaecptr nextpc = 0;
+    sm68k_disasm(instrname, instrcode, (uaecptr)pc, &nextpc, (uaecptr)pc);
+    if (mnemoBuf && mnemoSize > 0) {
+        strncpy(mnemoBuf, instrname, mnemoSize - 1);
+        mnemoBuf[mnemoSize - 1] = '\0';
+    }
+    if (hexBuf && hexSize > 0) {
+        strncpy(hexBuf, instrcode, hexSize - 1);
+        hexBuf[hexSize - 1] = '\0';
+    }
+    return (uint32_t)nextpc;
 }
