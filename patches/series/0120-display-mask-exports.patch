+RETRO_API void adm_set_bitplane_mask(uint8_t mask) {
+    extern int debug_bpl_mask;
+    extern int debug_bpl_mask_one;
+    debug_bpl_mask = (int)mask;
+    debug_bpl_mask_one = 0;
+}
+
+RETRO_API void adm_set_sprite_mask(uint8_t mask) {
+    extern int adm_sprite_mask_expanded;
+    int expanded = 0;
+    int i;
+    for (i = 0; i < 8; i++) {
+        if (mask & (1 << i))
+            expanded |= (3 << (2 * i));
+    }
+    adm_sprite_mask_expanded = expanded;
