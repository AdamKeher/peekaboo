+/* PEEKaboo: RTG write-watch.
+ *
+ * WinUAE allocates its memory with VirtualAlloc(MEM_WRITE_WATCH) and asks the
+ * kernel which pages of the RTG VRAM the guest wrote since the last frame, so
+ * picasso96.c only converts and copies those. This port reserves its memory
+ * through the mmap emulation above, which has no such facility on any platform
+ * it builds for, so the honest answer is "assume every page was written": the
+ * caller then converts the whole visible picture each frame.
+ *
+ * That is not the waste it looks like. The core hands the front-end a complete
+ * frame through video_cb() every time round retro_run() regardless, so the
+ * conversion is the only cost, and a "no pages dirty" answer here would simply
+ * stop the RTG screen updating - picasso96.c's flush loop does `continue` on a
+ * failed GetWriteWatch. Getting it wrong in that direction is a black screen;
+ * getting it wrong this way costs one pass over the picture.
+ *
+ * The contract is Win32 GetWriteWatch's, in plain types so that this compiles
+ * without windows.h: 0 on success, *count is capacity in and page count out,
+ * and addresses receives one pointer per dirty page. picasso96.c sizes its
+ * buffer from the granularity reported here, so the page size has to be the one
+ * picasso_allocatewritewatch() divided by.
+ */
+size_t mman_GetWriteWatchPageSize (void);
+
+int mman_GetWriteWatch (void *base, size_t size, void **addresses, size_t *count, unsigned int *granularity)
+{
+	uae_u8 *p = (uae_u8 *)base;
+	size_t page = mman_GetWriteWatchPageSize ();
+	size_t pages = (size + page - 1) / page;
+	size_t cap = count ? *count : 0;
+	size_t i;
+
+	if (granularity)
+		*granularity = (unsigned int)page;
+	if (!count)
+		return -1;
+	if (pages > cap)
+		pages = cap;
+	if (addresses) {
+		for (i = 0; i < pages; i++)
+			addresses[i] = p + i * page;
+	}
+	*count = pages;
+	return 0;
+}
+
+void mman_ResetWatch (void *base, size_t size)
+{
+	/* Nothing is tracked, so there is nothing to clear. */
+}
+
+/* The page size mman_GetWriteWatch() reports dirty pages in. Fixed rather than
+ * queried: it only has to be a size both sides agree on, and keeping it constant
+ * means the amount of work an RTG frame costs does not depend on the host. */
+size_t mman_GetWriteWatchPageSize (void)
+{
+	return 4096;
+}
