debug.c: step-over (z) stale nextpc fix

Generated from the inline patching that scripts/build_puae.ps1 and
scripts/build_puae.sh used to perform. Applies to libretro-uae
2b0ed42fe565fb997a0627aaa8f44e0948b527f8 in the order given by
patches/series.txt.

diff --git a/sources/src/debug.c b/sources/src/debug.c
index 95fcf1e..27ac964 100644
--- a/sources/src/debug.c
+++ b/sources/src/debug.c
@@ -6800,6 +6800,15 @@ static bool debug_line (TCHAR *input)
 			}
 			break;
 		case 'z':
+#ifdef __LIBRETRO__
+			/* adm: debug_parser() bypasses the interactive debug() loop that
+			   refreshes nextpc via m68k_dumpstate(), so nextpc is stale when a
+			   command arrives through adm_debug_command(). Recompute it from the
+			   live PC here; otherwise step-over (TRACE_MATCH_PC) targets a stale
+			   address and either steps into the subroutine or breaks at a random
+			   PC. m68k_disasm_ea() fills nextpc without any console output. */
+			m68k_disasm_ea (M68K_GETPC, &nextpc, 1, NULL, NULL, 0xffffffff);
+#endif
 			trace_mode = TRACE_MATCH_PC;
 			trace_param[0] = nextpc;
 			exception_debugging = 1;
