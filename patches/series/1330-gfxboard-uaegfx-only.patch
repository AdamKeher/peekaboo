+/* The two uaegfx types are not hardware boards and never reached find_board()
+ * even upstream, so these two keep their real answers: expansion.c reads the
+ * config type to decide whether the RTG window autoconfigs as Zorro II or III,
+ * and cfgfile.c matches gfxcard_type= against the config name. */
+const TCHAR *gfxboard_get_configname(int type)
+{
+	if (type == GFXBOARD_UAE_Z2)
+		return _T("ZorroII");
+	if (type == GFXBOARD_UAE_Z3)
+		return _T("ZorroIII");
+	return NULL;
