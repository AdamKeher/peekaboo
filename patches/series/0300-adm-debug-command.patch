+#include "debug.h"
+
+RETRO_API int adm_debug_command(const char *cmd, char *output_buf, int buf_len) {
+    if (!cmd || !*cmd) {
+        if (output_buf && buf_len > 0)
+            output_buf[0] = '\0';
+        return 0;
+    }
+    if (output_buf && buf_len > 0)
+        output_buf[0] = '\0';
+#ifdef DEBUGGER
+    {
+        const size_t cmd_len = strlen(cmd);
+        char *cmd_mut = (char*)malloc(cmd_len + 1);
+        if (!cmd_mut)
+            return -1;
+        memcpy(cmd_mut, cmd, cmd_len + 1);
+        debug_parser((TCHAR*)cmd_mut,
+                     (output_buf && buf_len > 0) ? (TCHAR*)output_buf : NULL,
+                     (uae_u32)((buf_len > 0) ? buf_len : 0));
+        free(cmd_mut);
+    }
+#endif
+    if (output_buf && buf_len > 0) {
+        output_buf[buf_len - 1] = '\0';
+        return (int)strlen(output_buf);
+    }
+    return 0;
 }
