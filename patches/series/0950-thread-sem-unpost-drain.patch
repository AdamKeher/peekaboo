thread.h: uae_sem_unpost drains instead of dropping the handle

Generated from the inline patching that scripts/build_puae.ps1 and
scripts/build_puae.sh used to perform. Applies to libretro-uae
2b0ed42fe565fb997a0627aaa8f44e0948b527f8 in the order given by
patches/series.txt.

diff --git a/retrodep/threaddep/thread.h b/retrodep/threaddep/thread.h
index 99a3297..96bce59 100644
--- a/retrodep/threaddep/thread.h
+++ b/retrodep/threaddep/thread.h
@@ -129,8 +129,11 @@ STATIC_INLINE void uae_sem_post (uae_sem_t *sem)
 
 STATIC_INLINE void uae_sem_unpost (uae_sem_t *sem)
 {
-    if (sem && sem->sem)
-        sem->sem = 0;
+    /* drain to zero instead of dropping the handle (named-sem fd leak) */
+    if (sem && sem->sem) {
+        while (sem_trywait (sem->sem) == 0)
+            ;
+    }
 }
 
 STATIC_INLINE void uae_sem_wait (uae_sem_t *sem)
@@ -178,8 +181,11 @@ STATIC_INLINE void uae_sem_post (uae_sem_t *sem)
 
 STATIC_INLINE void uae_sem_unpost (uae_sem_t *sem)
 {
-    if (sem && sem->sem)
-        sem->sem = 0;
+    /* drain to zero instead of dropping the handle (named-sem fd leak) */
+    if (sem && sem->sem) {
+        while (sem_trywait (sem->sem) == 0)
+            ;
+    }
 }
 
 STATIC_INLINE void uae_sem_wait (uae_sem_t *sem)
