+/* PEEKaboo: the host's serial port request, applied here on the emulation thread.
+ * serial_close() also clears the UART's loopback/empty-port state, and serial_open()
+ * picks it again from sername. A reload rebuilds prefs from the config, which has no
+ * port; the port the host asked for goes back in when that happens. */
+extern int adm_hostio_take_serial_request(char *out, int len);
+extern const char *adm_hostio_wanted_serial_port(void);
+extern void adm_hostio_poll(void);
+extern void serial_open(void);
+extern void serial_close(void);
+
+static void adm_serial_service(void)
+{
+   char wanted[256];
+   const char *keep = adm_hostio_wanted_serial_port();
+   bool apply = adm_hostio_take_serial_request(wanted, sizeof(wanted)) != 0;
+
+   if (!apply && keep && strcmp(currprefs.sername, keep))
+   {
+      strlcpy(wanted, keep, sizeof(wanted));
+      apply = true;
+   }
+   if (apply)
+   {
+      serial_close();
+      strlcpy(currprefs.sername, wanted, sizeof(currprefs.sername));
+      strlcpy(changed_prefs.sername, wanted, sizeof(changed_prefs.sername));
+      currprefs.use_serial = changed_prefs.use_serial = true;
+      serial_open();
+   }
+   adm_hostio_poll();
+}
+
 void retro_run(void)
 {
    static uint8_t old_frame = 0;
 
+   adm_serial_service();
+
    /* Core options */
    bool updated = false;
    if (environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE_UPDATE, &updated) && updated)
