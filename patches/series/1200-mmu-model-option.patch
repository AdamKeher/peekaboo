+            { NULL, NULL },
+         },
+         "auto"
+      },
       {
          "puae_cpu_throttle",
          "System > CPU Speed",
@@ -3495,6 +3512,25 @@
 static char opt_adm_agnus_model[16]        = "auto";
 static char opt_adm_agnus_size[16]         = "auto";
 static char opt_adm_denise_model[16]       = "auto";
+/* auto, full, ec or none. Applied beside the chipset, and for the same reason: the
+ * cpu_model option sets mmu_model to the CPU on every update while running. */
+static char opt_adm_mmu_model[8]           = "auto";
+
+/* The mmu_model value for `cpu`, or -1 to leave the core's own choice. */
+static int adm_mmu_model_for(int cpu, bool *ec)
+{
+   *ec = false;
+   if (!strcmp(opt_adm_mmu_model, "none"))
+      return 0;
+   if (!strcmp(opt_adm_mmu_model, "full"))
+      return cpu >= 68030 ? cpu : 0;
+   if (!strcmp(opt_adm_mmu_model, "ec"))
+   {
+      *ec = true;
+      return cpu >= 68030 ? cpu : 0;
+   }
+   return -1;
+}
 
 /* The cfgfile.c tables (csmode, cscompa, agnusmodel, agnussize, denisemodel), whose
  * indices are the prefs values. Casablanca and DraCo are left out: this build has
@@ -3552,6 +3588,15 @@
          : chipset == 2 ? CSMASK_ECS_DENISE
          : chipset == 3 ? CSMASK_ECS_DENISE | CSMASK_ECS_AGNUS
          : CSMASK_AGA | CSMASK_ECS_DENISE | CSMASK_ECS_AGNUS);
+
+   /* cpu_model has just set mmu_model to the CPU, or 0 below a 68030 */
+   {
+      bool ec  = false;
+      int  mmu = adm_mmu_model_for(changed_prefs.cpu_model, &ec);
+      if (mmu >= 0)
+         changed_prefs.mmu_model = mmu;
+      changed_prefs.mmu_ec = ec;
+   }
 }
 
