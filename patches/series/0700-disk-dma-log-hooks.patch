disk.c: disk DMA transfer logging hooks

Generated from the inline patching that scripts/build_puae.ps1 and
scripts/build_puae.sh used to perform. Applies to libretro-uae
2b0ed42fe565fb997a0627aaa8f44e0948b527f8 in the order given by
patches/series.txt.

diff --git a/sources/src/disk.c b/sources/src/disk.c
index 6f64132..0795ad6 100644
--- a/sources/src/disk.c
+++ b/sources/src/disk.c
@@ -3905,8 +3905,26 @@ void dumpdisk (const TCHAR *name)
 		side, dskdmaen, bitoffset, word, dskpt, dsklen, dskbytr_val, adkcon, dsksync);
 }
 
+/* ADM: disk DMA transfer log collectors. */
+extern void adm_record_disk_dma_start(int direction, uae_u32 dskpt_v, uae_u16 dsklen_v,
+                                      int drive, int cyl, int side_v, uae_u16 mfmpos_v,
+                                      uae_u16 dsksync_v, uae_u16 adkcon_v, int turbo);
+extern void adm_record_disk_dma_end(uae_u32 dskpt_end);
+extern void adm_record_disk_dma_abort(uae_u32 dskpt_end);
+
+void adm_disk_dma_begin(int dr)
+{
+	drive *drv = (dr >= 0 && dr < MAX_FLOPPY_DRIVES) ? &floppy[dr] : NULL;
+	adm_record_disk_dma_start(dskdmaen, dskpt, (uae_u16)dsklen,
+		drv ? dr : -1,
+		drv ? drv->cyl : 0, side,
+		(uae_u16)(drv ? drv->mfmpos : 0),
+		dsksync, adkcon,
+		drv ? (drv->useturbo || currprefs.floppy_speed == 0) : 0);
+}
 static void disk_dmafinished(void)
 {
+	adm_record_disk_dma_end(dskpt);
 	INTREQ_INT(1, 1);
 	if (floppy_writemode > 0)
 		floppy_writemode = 0;
@@ -4943,6 +4961,7 @@ static void DSKLEN_2(uae_u16 v, int hpos)
 					drive_write_data (drv2);
 				}
 			}
+			adm_record_disk_dma_abort(dskpt);
 			dskdmaen = DSKDMA_OFF;
 		}
 	}
@@ -5031,6 +5050,7 @@ static void DSKLEN_2(uae_u16 v, int hpos)
 		}
 	}
 
+	adm_disk_dma_begin(dr < MAX_FLOPPY_DRIVES ? dr : -1);
 	for (dr = 0; dr < MAX_FLOPPY_DRIVES; dr++)
 		update_drive_gui (dr, false);
 
