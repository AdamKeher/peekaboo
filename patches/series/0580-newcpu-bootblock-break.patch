 /* ADM: per-instruction CPU trace capture helper (called from m68k_run_1/1_ce) */
 extern int adm_cpu_trace_enabled;
 extern void adm_record_cpu_trace(uint16_t, uint16_t, uint32_t, const uint8_t*, uint8_t, const uint32_t*, uint16_t);
+#ifdef __LIBRETRO__
+/* ADM: break-on-bootblock-entry (FB) one-shot trap. Address-agnostic: detects
+   the ROM->chipRAM handoff to a bootblock by the DOS signature + boot checksum
+   12 bytes behind the entry PC (Kickstart JSRs to bootblock+12). */
+int adm_fb_armed = 0;
+uint32_t adm_fb_entry = 0;
+int adm_fb_hit = 0;
+uint32_t adm_fb_prev_pc = 0xFFFFFFFF;
+int adm_fb_check(uint32_t pc) {
+	uint32_t prev = adm_fb_prev_pc, sum = 0, i;
+	adm_fb_prev_pc = pc;
+	if (!adm_fb_armed) return 0;
+	if (pc < 12 || pc >= chipmem_bank.allocated_size) return 0;
+	if (prev < 0x00E00000) return 0;
+	if ((get_long(pc - 12) & 0xFFFFFF00) != 0x444F5300) return 0;
+	for (i = 0; i < 256; i++) {
+		uint32_t old = sum; sum += get_long(pc - 12 + i * 4); if (sum < old) sum++;
+	}
+	if (sum != 0xFFFFFFFF) return 0;
+	adm_fb_armed = 0; adm_fb_hit = 1; adm_fb_entry = pc;
+	return 1;
+}
+#endif
 static void adm_cpu_trace_pre(struct regstruct *r) {
 	int adm_i, adm_wlen;
 	uint8_t adm_raw[10];
