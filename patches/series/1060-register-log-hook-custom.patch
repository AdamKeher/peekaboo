custom.c: custom register write-log hook

Generated from the inline patching that scripts/build_puae.ps1 and
scripts/build_puae.sh used to perform. Applies to libretro-uae
2b0ed42fe565fb997a0627aaa8f44e0948b527f8 in the order given by
patches/series.txt.

diff --git a/sources/src/custom.c b/sources/src/custom.c
index 3b8ec97..190269c 100644
--- a/sources/src/custom.c
+++ b/sources/src/custom.c
@@ -15582,6 +15582,8 @@ static uae_u32 REGPARAM2 custom_lget (uaecptr addr)
 }
 /* ADM: latch the DSKLEN writer for the disk DMA log */
 extern void adm_disk_set_trigger(uint32_t pc, uint8_t from_copper);
+/* ADM: log every CPU/Copper custom-register write (see PATCHES.md) */
+extern void adm_record_reg_write(uint16_t, uint16_t, uint16_t, uint16_t, uint32_t, uint8_t);
 static int REGPARAM2 custom_wput_1 (int hpos, uaecptr addr, uae_u32 value, int noget)
 {
 	uaecptr oaddr = addr;
@@ -15589,6 +15591,10 @@ static int REGPARAM2 custom_wput_1 (int hpos, uaecptr addr, uae_u32 value, int n
 	value &= 0xffff;
 	custom_storage[addr >> 1].value = (uae_u16)value;
 	custom_storage[addr >> 1].pc = copper_access ? cop_state.ip | 1 : M68K_GETPC;
+	/* ADM register-log: addr and value are already masked at this point. */
+	adm_record_reg_write((uint16_t)vpos, (uint16_t)hpos, (uint16_t)addr, (uint16_t)value,
+	                     copper_access ? (uint32_t)(cop_state.ip - 4) : (uint32_t)regs.instruction_pc,
+	                     (uint8_t)copper_access);
 #ifdef ACTION_REPLAY
 #ifdef ACTION_REPLAY_COMMON
 	ar_custom[addr + 0]=(uae_u8)(value >> 8);
