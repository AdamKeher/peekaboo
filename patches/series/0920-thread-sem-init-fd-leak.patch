thread.c: uae_sem_init fd-leak fix (macOS named semaphores)

Generated from the inline patching that scripts/build_puae.ps1 and
scripts/build_puae.sh used to perform. Applies to libretro-uae
2b0ed42fe565fb997a0627aaa8f44e0948b527f8 in the order given by
patches/series.txt.

diff --git a/retrodep/threaddep/thread.c b/retrodep/threaddep/thread.c
index 1839f7b..59fd476 100644
--- a/retrodep/threaddep/thread.c
+++ b/retrodep/threaddep/thread.c
@@ -164,6 +164,9 @@ void uae_sem_init (uae_sem_t *sem, int pshared, unsigned int value)
     static int semno = 0;
     int result = 0;
 
+    if (sem->sem)
+        sem_close (sem->sem);  /* prevent fd leak on re-init without prior destroy */
+
     sprintf (name, "/uaesem-%d-%d", getpid (), semno++);
 
     if ((sem->sem = sem_open (name, O_CREAT, 0600, value)) != (sem_t *)SEM_FAILED)
