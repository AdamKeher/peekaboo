+/* PEEKaboo: WHDLoad file-mode installation (WHDLoad/ and WHDSaves/ in the save directory),
+ * split out of retro_create_config() for the same reason. Fills both paths; true when all
+ * three directories exist. */
+static bool whdload_prepare_file_mode(char *whdload_path, char *whdsaves_path)
+{
+   char whdload_prefs_path[RETRO_PATH_MAX];
+   path_join(whdload_prefs_path, retro_system_directory, "WHDLoad.prefs");
+
+   path_join(whdload_path, retro_save_directory, "WHDLoad");
+
+   char whdload_c_path[RETRO_PATH_MAX];
+   path_join(whdload_c_path, retro_save_directory, "WHDLoad/C");
+
+   /* Verify WHDLoad */
+   if (!path_is_directory(whdload_path) || (path_is_directory(whdload_path) && !path_is_directory(whdload_c_path)))
+   {
+      log_cb(RETRO_LOG_INFO, "WHDLoad image directory \"%s\" not found, attempting to create...\n", whdload_path);
+      path_mkdir(whdload_path);
+
+      char whdload_files_zip_path[RETRO_PATH_MAX];
+      path_join(whdload_files_zip_path, retro_save_directory, "WHDLoad_files.zip");
+
+      FILE *whdload_files_zip_fp;
+      if ((whdload_files_zip_fp = fopen(whdload_files_zip_path, "wb")))
+      {
+         /* Write ZIP */
+         fwrite(___whdload_WHDLoad_files_zip, ___whdload_WHDLoad_files_zip_len, 1, whdload_files_zip_fp);
+         fclose(whdload_files_zip_fp);
+
+         /* Extract ZIP */
+         zip_uncompress(whdload_files_zip_path, whdload_path, NULL);
+         retro_remove(whdload_files_zip_path);
+      }
+
+      if (!path_is_directory(whdload_c_path))
+         log_cb(RETRO_LOG_ERROR, "Unable to create WHDLoad image directory: \"%s\".\n", whdload_path);
+   }
+   if (path_is_directory(whdload_path) && path_is_directory(whdload_c_path))
+   {
+      /* Check and copy Kickstarts */
+      whdload_kscopy(false);
+
+      /* Copy required files host-wise with file mode */
+      if (path_is_valid(whdload_prefs_path))
+         whdload_prefs_copy();
+
+      /* Rename theme prefs if necessary */
+      char whdload_theme_path[RETRO_PATH_MAX];
+      path_join(whdload_theme_path, retro_save_directory, "WHDLoad/Devs/system-configuration");
+      char whdload_theme_default_path[RETRO_PATH_MAX];
+      path_join(whdload_theme_default_path, retro_save_directory, "WHDLoad/Devs/system-configuration-default");
+      char whdload_theme_native_path[RETRO_PATH_MAX];
+      path_join(whdload_theme_native_path, retro_save_directory, "WHDLoad/Devs/system-configuration-native");
+
+      /* Default (black) */
+      if (!opt_use_whdload_theme)
+      {
+         if (path_is_valid(whdload_theme_path) && path_is_valid(whdload_theme_default_path))
+         {
+            if (fcmp(whdload_theme_path, whdload_theme_default_path))
+            {
+               if (fcopy(whdload_theme_default_path, whdload_theme_path) < 0)
+                  log_cb(RETRO_LOG_INFO, "WHDLoad failed to change theme to \"Default\".\n");
+               else
+                  log_cb(RETRO_LOG_INFO, "WHDLoad changed theme to \"Default\".\n");
+            }
+         }
+         else if (!path_is_valid(whdload_theme_default_path) && !path_is_valid(whdload_theme_native_path))
+            ; /* No-op fallback */
+         else
+            log_cb(RETRO_LOG_INFO, "WHDLoad theme \"Default\" not found. Delete \"WHDLoad\" directory to reinstall!\n");
+      }
+      /* Native (gray) */
+      else
+      {
+         if (path_is_valid(whdload_theme_path) && path_is_valid(whdload_theme_native_path))
+         {
+            if (fcmp(whdload_theme_path, whdload_theme_native_path))
+            {
+               if (fcopy(whdload_theme_native_path, whdload_theme_path) < 0)
+                  log_cb(RETRO_LOG_INFO, "WHDLoad failed to change theme to \"Native\".\n");
+               else
+                  log_cb(RETRO_LOG_INFO, "WHDLoad changed theme to \"Native\".\n");
+            }
+         }
+         else
+            log_cb(RETRO_LOG_INFO, "WHDLoad theme \"Native\" not found. Delete \"WHDLoad\" directory to reinstall!\n");
+      }
+   }
+
+   /* Verify WHDSaves */
+   path_join(whdsaves_path, retro_save_directory, "WHDSaves");
+   if (!path_is_directory(whdsaves_path))
+      path_mkdir(whdsaves_path);
+
+   return path_is_directory(whdload_path) && path_is_directory(whdload_c_path)
+       && path_is_directory(whdsaves_path);
+}
+
+/* PEEKaboo: WHDLoad, CD and archive exports.
+ *
+ * PEEKaboo boots WHDLoad archives and CD images from a .uae it generates itself, so it never
+ * reaches the content-loader paths in retro_create_config() that prepare WHDLoad or insert a
+ * disc. These exports hand it the same preparation, and a way to change the disc while the
+ * machine runs: in this build the libretro disk-control index selects a floppy drive, so a CD
+ * cannot be swapped through it. */
+
+RETRO_API int adm_whdload_prepare(int button_wait, int no_write_cache, int prefs_mode, int theme,
+                                  char *out_whdload_dir, char *out_saves_dir, int len)
+{
+   char whdload_path[RETRO_PATH_MAX]  = {0};
+   char whdsaves_path[RETRO_PATH_MAX] = {0};
+   bool ok;
+
+   if (string_is_empty(retro_save_directory) || string_is_empty(retro_system_directory))
+      return 0;
+
+   opt_use_whdload_buttonwait   = button_wait != 0;
+   opt_use_whdload_nowritecache = no_write_cache != 0;
+   opt_use_whdload_prefs        = (prefs_mode >= 0 && prefs_mode <= 3) ? (uint8_t)prefs_mode : 0;
+   opt_use_whdload_theme        = theme ? 1 : 0;
+
+   /* whdload_prepare_prefs() reads opt_use_whdload for WriteDelay: file mode is the only mode
+    * this export prepares. */
+   opt_use_whdload = 1;
+
+   path_mkdir(retro_save_directory);
+   whdload_prepare_prefs();
+   ok = whdload_prepare_file_mode(whdload_path, whdsaves_path);
+
+   if (out_whdload_dir && len > 0)
+      strlcpy(out_whdload_dir, whdload_path, (size_t)len);
+   if (out_saves_dir && len > 0)
+      strlcpy(out_saves_dir, whdsaves_path, (size_t)len);
+   return ok ? 1 : 0;
+}
+
+RETRO_API int adm_cd_insert(const char *path)
+{
+   if (!path || !path[0] || strlen(path) >= sizeof(changed_prefs.cdslots[0].name))
+      return 0;
+   strlcpy(changed_prefs.cdslots[0].name, path, sizeof(changed_prefs.cdslots[0].name));
+   changed_prefs.cdslots[0].inuse = true;
+   set_config_changed();
+   return 1;
+}
+
+RETRO_API void adm_cd_eject(void)
+{
+   changed_prefs.cdslots[0].name[0] = 0;
+   changed_prefs.cdslots[0].inuse   = false;
+   set_config_changed();
+}
+
+/* 1 when a disc is in CD0 as far as the running machine knows, 0 when it is empty. The image
+ * path is copied out either way (empty when there is none). */
+RETRO_API int adm_cd_get_image(char *out, int len)
+{
+   if (out && len > 0)
+      strlcpy(out, currprefs.cdslots[0].name, (size_t)len);
+   return currprefs.cdslots[0].name[0] ? 1 : 0;
+}
+
+/* Extract a .zip or .7z into dest_dir, which is created if needed. Returns 1 on success. */
+RETRO_API int adm_extract_archive(const char *archive, const char *dest_dir)
+{
+   if (!archive || !dest_dir || !path_is_valid(archive))
+      return 0;
+   if (!path_is_directory(dest_dir))
+      path_mkdir(dest_dir);
+   if (!path_is_directory(dest_dir))
+      return 0;
+   if (strendswith(archive, ".zip") || strendswith(archive, ".ZIP"))
+      zip_uncompress((char *)archive, (char *)dest_dir, NULL);
+   else if (strendswith(archive, ".7z") || strendswith(archive, ".7Z"))
+      sevenzip_uncompress((char *)archive, (char *)dest_dir, NULL);
+   else
+      return 0;
+   return 1;
+}
