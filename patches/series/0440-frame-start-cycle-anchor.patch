libretro-core.c: frame-start cycle anchor

Generated from the inline patching that scripts/build_puae.ps1 and
scripts/build_puae.sh used to perform. Applies to libretro-uae
2b0ed42fe565fb997a0627aaa8f44e0948b527f8 in the order given by
patches/series.txt.

diff --git a/libretro/libretro-core.c b/libretro/libretro-core.c
index 84410b3..bd99eb0 100644
--- a/libretro/libretro-core.c
+++ b/libretro/libretro-core.c
@@ -9642,4 +9642,23 @@ RETRO_API int adm_get_blit_data(uint32_t off, uint32_t count, void* out) {
     for (i = 0; i < count; i++)
         dst[i] = adm_blit_data_arena[(off + i) & (ADM_BLITDATA_SLOTS - 1)];
     return (int)count;
+}
+static uint32_t adm_frame_start_cycle_val = 0;
+static uint32_t adm_prev_frame_start_cycle_val = 0;
+void adm_cpu_trace_frame_boundary(void);
+RETRO_API uint32_t adm_get_frame_start_cycles(void) {
+    return adm_frame_start_cycle_val;
+}
+void adm_record_frame_start(void) {
+    adm_prev_frame_start_cycle_val = adm_frame_start_cycle_val;
+    adm_frame_start_cycle_val = (uint32_t)(get_cycles() / 512);
+    adm_cpu_trace_frame_boundary();
+}
+/* Current beam position — lets the host place a "playhead" at a mid-frame breakpoint
+   stop and clip per-frame event views to [frame start, break]. cycle is in the same
+   get_cycles()/512 CCK units as every adm_*_events stamp and adm_get_frame_start_cycles. */
+RETRO_API void adm_get_beampos(uint32_t* cycle, int* vp, int* hp) {
+    if (cycle) *cycle = (uint32_t)(get_cycles() / 512);
+    if (vp) *vp = vpos;
+    if (hp) *hp = current_hpos();
 }
