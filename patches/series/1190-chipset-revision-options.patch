+/* PEEKaboo: the chipset and its board bundle as config rows. Appended after the
+ * content's own rows so an override outranks the preset and a .uae alike (the .uae
+ * branch drops its chipset= rows anyway whenever a model is selected). The chip models
+ * are not rows: adm_chipset_models_hook applies them. */
+static void adm_machine_overrides_config(void)
+{
+   int compatible = adm_option_index(opt_adm_chipset_compatible, adm_compatible_names, 1);
+   int chipset    = adm_option_index(opt_adm_chipset, adm_chipset_names, 0);
+
+   if (compatible > 0)
+      retro_config_append("chipset_compatible=%s\n", adm_compatible_names[compatible]);
+   if (chipset >= 0)
+      retro_config_append("chipset=%s\n", adm_chipset_names[chipset]);
+}
+
+/* PEEKaboo: the machine the core is actually running, straight from currprefs, so the
+ * host can show what an override produced rather than what it asked for. Fills up to
+ * `count` ints in this order and returns how many it wrote:
+ *   0 chipset_mask (CSMASK_*)   1 cs_compatible (CP_*)   2 cs_agnusmodel
+ *   3 cs_agnussize               4 cs_denisemodel         5 cpu_model
+ *   6 fpu_model                  7 mmu_model              8 mmu_ec
+ *   9 address_space_24 */
+RETRO_API int adm_get_machine_config(int *out, int count)
+{
+   int values[10];
+   int i;
+
+   if (!out || count <= 0)
+      return 0;
+
+   values[0] = currprefs.chipset_mask;
+   values[1] = currprefs.cs_compatible;
+   values[2] = currprefs.cs_agnusmodel;
+   values[3] = currprefs.cs_agnussize;
+   values[4] = currprefs.cs_denisemodel;
+   values[5] = currprefs.cpu_model;
+   values[6] = currprefs.fpu_model;
+   values[7] = currprefs.mmu_model;
+   values[8] = currprefs.mmu_ec ? 1 : 0;
+   values[9] = currprefs.address_space_24 ? 1 : 0;
+
+   if (count > 10)
+      count = 10;
+   for (i = 0; i < count; i++)
+      out[i] = values[i];
+   return count;
+}
