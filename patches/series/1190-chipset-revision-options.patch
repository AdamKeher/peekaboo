+/* PEEKaboo: chipset revision overrides below the model preset.
+ *
+ * puae_chipset, puae_chipset_compatible, puae_agnus_model, puae_agnus_size and
+ * puae_denise_model take the cfgfile.c vocabulary, or "auto" for the preset's own
+ * choice. The chipset and its board bundle are applied like cpu_model, twice: as
+ * config rows after everything a boot appends (adm_machine_overrides_config), and to
+ * changed_prefs on every option update while running (adm_machine_overrides_runtime).
+ * The second is not optional: the "model" option rewrites chipset_mask, cs_compatible
+ * and every cs_* field back to the preset whenever any option changes, which would
+ * quietly put an overridden machine back to stock the first time a volume slider moved.
+ *
+ * The three chip models cannot be config rows at all: built_in_chipset_prefs() resets
+ * them from the bundle, and fixup_prefs() calls it after every config load. They go
+ * in through adm_chipset_prefs_hook instead, which that function calls last. */
+static char opt_adm_chipset[16]            = "auto";
+static char opt_adm_chipset_compatible[16] = "auto";
+static char opt_adm_agnus_model[16]        = "auto";
+static char opt_adm_agnus_size[16]         = "auto";
+static char opt_adm_denise_model[16]       = "auto";
+
+/* The cfgfile.c tables (csmode, cscompa, agnusmodel, agnussize, denisemodel), whose
+ * indices are the prefs values. Casablanca and DraCo are left out: this build has
+ * neither machine. */
+static const char *adm_chipset_names[]      = { "ocs", "ecs_agnus", "ecs_denise", "ecs", "aga", NULL };
+static const char *adm_compatible_names[]   = { "-", "Generic", "CDTV", "CDTV-CR", "CD32", "A500",
+                                                "A500+", "A600", "A1000", "A1200", "A2000", "A3000",
+                                                "A3000T", "A4000", "A4000T", "Velvet", NULL };
+static const char *adm_agnus_model_names[]  = { "default", "velvet", "a1000", "ocs", "ecs", "aga", NULL };
+static const char *adm_agnus_size_names[]   = { "default", "512k", "1m", "2m", NULL };
+static const char *adm_denise_model_names[] = { "default", "velvet", "a1000_noehb", "a1000", "ocs",
+                                                "ecs", "aga", NULL };
+
+/* Index of value in names, or -1 for "auto", for index 0 where it means "none"
+ * (every table but csmode), and for anything the table does not have. */
+static int adm_option_index(const char *value, const char **names, int first)
+{
+   int i;
+   for (i = first; names[i]; i++)
+      if (!strcmp(value, names[i]))
+         return i;
+   return -1;
+}
+
+extern void (*adm_chipset_prefs_hook)(struct uae_prefs *p);
+
+/* Called by built_in_chipset_prefs() after it has reset the chip models. */
+static void adm_chipset_models_hook(struct uae_prefs *p)
+{
+   int agnus  = adm_option_index(opt_adm_agnus_model, adm_agnus_model_names, 1);
+   int size   = adm_option_index(opt_adm_agnus_size, adm_agnus_size_names, 1);
+   int denise = adm_option_index(opt_adm_denise_model, adm_denise_model_names, 1);
+
+   if (agnus > 0)
+      p->cs_agnusmodel = agnus;
+   if (size > 0)
+      p->cs_agnussize = size;
+   if (denise > 0)
+      p->cs_denisemodel = denise;
+}
+
+static void adm_machine_overrides_runtime(void)
+{
+   int compatible = adm_option_index(opt_adm_chipset_compatible, adm_compatible_names, 1);
+   int chipset    = adm_option_index(opt_adm_chipset, adm_chipset_names, 0);
+
+   if (compatible > 0)
+      changed_prefs.cs_compatible = currprefs.cs_compatible = compatible;
+   /* The "model" option has just run this with the preset's bundle; once more with the
+    * override's, which also brings the chip models back through the hook. */
+   built_in_chipset_prefs(&changed_prefs);
+   if (chipset >= 0)
+      changed_prefs.chipset_mask = (chipset == 0 ? 0
+         : chipset == 1 ? CSMASK_ECS_AGNUS
+         : chipset == 2 ? CSMASK_ECS_DENISE
+         : chipset == 3 ? CSMASK_ECS_DENISE | CSMASK_ECS_AGNUS
+         : CSMASK_AGA | CSMASK_ECS_DENISE | CSMASK_ECS_AGNUS);
+}
