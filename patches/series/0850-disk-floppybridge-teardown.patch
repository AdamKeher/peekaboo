disk.c: a dropped bridge closes its port

Generated from the inline patching that scripts/build_puae.ps1 and
scripts/build_puae.sh used to perform. Applies to libretro-uae
2b0ed42fe565fb997a0627aaa8f44e0948b527f8 in the order given by
patches/series.txt.

diff --git a/sources/src/disk.c b/sources/src/disk.c
index 23618ca..7afb721 100644
--- a/sources/src/disk.c
+++ b/sources/src/disk.c
@@ -5449,9 +5449,17 @@ static void floppybridge_init2(struct uae_prefs *p)
 		for (int dr = 0; dr < MAX_FLOPPY_DRIVES; dr++) {
 			floppy[dr].bridge = NULL;
 			if (bridges[dr]) {
+				/* ADM: shutdown() before delete. ~CommonBridgeTemplate() joins
+				   the worker thread but never calls closeInterface(), so a plain
+				   delete left the serial port open and the next attach to the
+				   same port failed. The two teardown sites further down this
+				   function already do it this way. */
+				bridges[dr]->shutdown();
 				delete bridges[dr];
 				bridges[dr] = NULL;
 			}
+			bridge_driver[dr] = NULL;
+			bridge_type[dr] = -1;
 		}
 		return;
 	}
