custom.c: chipset write-block hooks

Generated from the inline patching that scripts/build_puae.ps1 and
scripts/build_puae.sh used to perform. Applies to libretro-uae
2b0ed42fe565fb997a0627aaa8f44e0948b527f8 in the order given by
patches/series.txt.

diff --git a/sources/src/custom.c b/sources/src/custom.c
index 894688f..3b8ec97 100644
--- a/sources/src/custom.c
+++ b/sources/src/custom.c
@@ -517,6 +517,11 @@ int firstword_bplcon1;
 static int last_copper_hpos;
 static int copper_access;
 
+/* ADM chipset write blocks: implementation in patches/adm_chipset_blocks.inc
+   (see PATCHES.md). Included here, after copper_access and vpos are declared
+   and before both use sites, because it reads custom.c file statics. */
+#include "adm_chipset_blocks.inc"
+
 /* Sprite collisions */
 static unsigned int clxdat, clxcon, clxcon2, clxcon_bpl_enable, clxcon_bpl_match;
 
@@ -10789,6 +10794,12 @@ static bool copper_cant_read(int hpos, uae_u16 alloc)
 static int custom_wput_copper(int hpos, uaecptr pt, uaecptr addr, uae_u32 value, int noget)
 {
 	int v;
+	/* ADM copper block: drop the write and leave the copper running. Ahead of
+	   debug_putpeekdma_chipset so a blocked write is invisible to DMA debug and
+	   memory watchpoints too. */
+	if (adm_is_copper_line_blocked(vpos)) {
+		return 0;
+	}
 
 #ifdef DEBUGGER
 	value = debug_putpeekdma_chipset(0xdff000 + addr, value, MW_MASK_COPPER, 0x08c);
@@ -15697,18 +15708,19 @@ static int REGPARAM2 custom_wput_1 (int hpos, uaecptr addr, uae_u32 value, int n
 	case 0x0D8: AUDxVOL(3, value); break;
 	case 0x0DA: AUDxDAT(3, value); break;
 
-	case 0x0E0: BPLxPTH(hpos, value, 0); break;
-	case 0x0E2: BPLxPTL(hpos, value, 0); break;
-	case 0x0E4: BPLxPTH(hpos, value, 1); break;
-	case 0x0E6: BPLxPTL(hpos, value, 1); break;
-	case 0x0E8: BPLxPTH(hpos, value, 2); break;
-	case 0x0EA: BPLxPTL(hpos, value, 2); break;
-	case 0x0EC: BPLxPTH(hpos, value, 3); break;
-	case 0x0EE: BPLxPTL(hpos, value, 3); break;
-	case 0x0F0: BPLxPTH(hpos, value, 4); break;
-	case 0x0F2: BPLxPTL(hpos, value, 4); break;
-	case 0x0F4: BPLxPTH(hpos, value, 5); break;
-	case 0x0F6: BPLxPTL(hpos, value, 5); break;
+	/* ADM bitplane-pointer block: copper writes only, planes 1-6. */
+	case 0x0E0: if (!adm_is_copper_bplptr_write_blocked(addr)) { BPLxPTH(hpos, value, 0); } break;
+	case 0x0E2: if (!adm_is_copper_bplptr_write_blocked(addr)) { BPLxPTL(hpos, value, 0); } break;
+	case 0x0E4: if (!adm_is_copper_bplptr_write_blocked(addr)) { BPLxPTH(hpos, value, 1); } break;
+	case 0x0E6: if (!adm_is_copper_bplptr_write_blocked(addr)) { BPLxPTL(hpos, value, 1); } break;
+	case 0x0E8: if (!adm_is_copper_bplptr_write_blocked(addr)) { BPLxPTH(hpos, value, 2); } break;
+	case 0x0EA: if (!adm_is_copper_bplptr_write_blocked(addr)) { BPLxPTL(hpos, value, 2); } break;
+	case 0x0EC: if (!adm_is_copper_bplptr_write_blocked(addr)) { BPLxPTH(hpos, value, 3); } break;
+	case 0x0EE: if (!adm_is_copper_bplptr_write_blocked(addr)) { BPLxPTL(hpos, value, 3); } break;
+	case 0x0F0: if (!adm_is_copper_bplptr_write_blocked(addr)) { BPLxPTH(hpos, value, 4); } break;
+	case 0x0F2: if (!adm_is_copper_bplptr_write_blocked(addr)) { BPLxPTL(hpos, value, 4); } break;
+	case 0x0F4: if (!adm_is_copper_bplptr_write_blocked(addr)) { BPLxPTH(hpos, value, 5); } break;
+	case 0x0F6: if (!adm_is_copper_bplptr_write_blocked(addr)) { BPLxPTL(hpos, value, 5); } break;
 	case 0x0F8: BPLxPTH(hpos, value, 6); break;
 	case 0x0FA: BPLxPTL(hpos, value, 6); break;
 	case 0x0FC: BPLxPTH(hpos, value, 7); break;
