+/* PEEKaboo optional extension: retain filesystem-unit activity instead of collapsing all
+ * directory and hardfile traffic into libretro LED 7. Counts are exchanged atomically because
+ * directory units can execute on PuAE filesystem worker threads. */
+#define ADM_HD_ACTIVITY_UNITS 32
+static volatile unsigned adm_hd_reads[ADM_HD_ACTIVITY_UNITS];
+static volatile unsigned adm_hd_writes[ADM_HD_ACTIVITY_UNITS];
+
+typedef struct adm_hd_activity_event {
+    int unit;
+    int status;
+    unsigned count;
+} adm_hd_activity_event_t;
+
+RETRO_API int adm_drain_hd_activity(void *output, int maximum)
+{
+    adm_hd_activity_event_t *events = (adm_hd_activity_event_t *)output;
+    int count = 0;
+    for (int unit = 0; unit < ADM_HD_ACTIVITY_UNITS && count < maximum; ++unit) {
+        unsigned reads = __atomic_exchange_n(&adm_hd_reads[unit], 0, __ATOMIC_ACQ_REL);
+        unsigned writes = __atomic_exchange_n(&adm_hd_writes[unit], 0, __ATOMIC_ACQ_REL);
+        if (reads && count < maximum)
+            events[count++] = (adm_hd_activity_event_t){unit, 1, reads};
+        if (writes && count < maximum)
+            events[count++] = (adm_hd_activity_event_t){unit, 2, writes};
+    }
+    return count;
+}
+
