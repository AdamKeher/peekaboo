#pragma once

#include <string>

// screenscraper.fr API credentials for DiskIdentifier.
//
// The real file (src/Secrets.h) is gitignored and machine-local. When it is absent, CMake
// points the build at a copy of this file instead: the build succeeds and DiskIdentifier
// skips the screenscraper lookups (empty SS_DEVID/SS_DEVPASS). Register a developer account
// at https://www.screenscraper.fr to obtain real keys, then copy this file to src/Secrets.h
// and fill them in.
constexpr const char* SS_DEVID = "";
constexpr const char* SS_DEVPASS = "";
constexpr const char* SS_SOFTNAME = "Peekaboo";
