  "bplcon0": {
    "bits": 16,
    "fields": [
      {
        "hi": 15,
        "lo": 15,
        "name": "HIRES",
        "desc": "HIRES = High resolution (640*200/640*400 interlace) mode"
      },
      {
        "hi": 14,
        "lo": 12,
        "name": "BPUx",
        "desc": "Bit planes use"
      },
      {
        "hi": 11,
        "lo": 11,
        "name": "HAM",
        "desc": "Hold and modify mode, now using either 6 or 8 bit planes."
      },
      {
        "hi": 10,
        "lo": 10,
        "name": "DPF",
        "desc": "Double playfield (PF1 = odd & PF2 = even bit planes) now available in all resolutions. (If BPU = 6 and HAM = 0 and DPF = 0 a special mode is defined that allows bitplane 6 to cause an intensity reduction of the other 5 bitplanes. The color register output selected by 5 bitplanes is shifted to half intensity by the 6th bit plane. This is called EXTRA-HALFBRITE Mode."
      },
      {
        "hi": 9,
        "lo": 9,
        "name": "COLOR",
        "desc": "Enables color burst output signal"
      },
      {
        "hi": 8,
        "lo": 8,
        "name": "GAUD",
        "desc": "Genlock audio enable. This level appears on the ZD pin on denise during all blanking periods, unless ZDCLK bit is set."
      },
      {
        "hi": 7,
        "lo": 7,
        "name": "UHRES",
        "desc": "Ultrahi res enables the UHRES pointers (for 1k*1k) also needs bits in DMACON (hires chips only). Disables hard stops for vert, horiz display windows."
      },
      {
        "hi": 6,
        "lo": 6,
        "name": "SHRES",
        "desc": "Super hi-res mode (35ns pixel width)"
      },
      {
        "hi": 5,
        "lo": 5,
        "name": "BYPASS=0",
        "desc": "Bit planes are scrolled and prioritized normally, but bypass color table and 8 bit wide data appear on R(7:0)."
      },
      {
        "hi": 4,
        "lo": 4,
        "name": "BPU3=0",
        "desc": "See above (BPUx)"
      },
      {
        "hi": 3,
        "lo": 3,
        "name": "LPEN",
        "desc": "Light pen enable (reset on power up)"
      },
      {
        "hi": 2,
        "lo": 2,
        "name": "LACE",
        "desc": "Interlace enable (reset on power up)"
      },
      {
        "hi": 1,
        "lo": 1,
        "name": "ERSY",
        "desc": "External resync (HSYNC, VSYNC pads become inputs) (reset on power up)"
      },
      {
        "hi": 0,
        "lo": 0,
        "name": "ECSENA=0",
        "desc": "When low (default), the following bits in BPLCON3 are disabled: BRDRBLNK,BRDNTRAN,ZDCLKEN,BRDSPRT, and EXTBLKEN. These 5 bits can always be set by writing to BPLCON3, however there effects are inhibited until ECSENA goes high. This allows rapid context switching between pre-ECS viewports and new ones."
      }
    ]
  },
  "bplcon1": {
    "bits": 16,
    "fields": [
      {
        "hi": 15,
        "lo": 15,
        "name": "PF2H7",
        "desc": "(PF2Hx =) Playfield 2 horizontal scroll code, x=0-7"
      },
      {
        "hi": 14,
        "lo": 14,
        "name": "PF2H6",
        "desc": ""
      },
      {
        "hi": 13,
        "lo": 13,
        "name": "PF2H1",
        "desc": ""
      },
      {
        "hi": 12,
        "lo": 12,
        "name": "PF2H0",
        "desc": ""
      },
      {
        "hi": 11,
        "lo": 11,
        "name": "PF1H7",
        "desc": "(PF1Hx =) Playfield 1 horizontal scroll code, x=0-7 where PFyH0 = LSB = 35ns SHRES pixel (bits have been renamed, old PFyH0 now PFyH2, etc). Now that the scroll range has been quadrupled to allow for wider (32 or 64 bits) bitplanes."
      },
      {
        "hi": 10,
        "lo": 10,
        "name": "PF1H6",
        "desc": ""
      },
      {
        "hi": 9,
        "lo": 9,
        "name": "PF1H1",
        "desc": ""
      },
      {
        "hi": 8,
        "lo": 8,
        "name": "PF1H0",
        "desc": ""
      },
      {
        "hi": 7,
        "lo": 7,
        "name": "PF2H5",
        "desc": "OCS/ECS"
      },
      {
        "hi": 6,
        "lo": 6,
        "name": "PF2H4",
        "desc": ""
      },
      {
        "hi": 5,
        "lo": 5,
        "name": "PF2H3",
        "desc": ""
      },
      {
        "hi": 4,
        "lo": 4,
        "name": "PF2H2",
        "desc": ""
      },
      {
        "hi": 3,
        "lo": 3,
        "name": "PF1H5",
        "desc": ""
      },
      {
        "hi": 2,
        "lo": 2,
        "name": "PF1H4",
        "desc": ""
      },
      {
        "hi": 1,
        "lo": 1,
        "name": "PF1H3",
        "desc": ""
      },
      {
        "hi": 0,
        "lo": 0,
        "name": "PF1H2",
        "desc": ""
      }
    ]
  },
  "bplcon2": {
    "bits": 16,
    "fields": [
      {
        "hi": 14,
        "lo": 14,
        "name": "ZDBPSEL2",
        "desc": "3 bit field which selects which bitplane is to be used for ZD when ZDBBPEN is set- 000 selects BB1 and 111 selects BP8."
      },
      {
        "hi": 13,
        "lo": 13,
        "name": "ZDBPSEL1",
        "desc": ""
      },
      {
        "hi": 12,
        "lo": 12,
        "name": "ZDBPSEL0",
        "desc": ""
      },
      {
        "hi": 11,
        "lo": 11,
        "name": "ZDBPEN",
        "desc": "Causes ZD pin to mirror bitplane selected by ZDBPSELx bits. This does not disable the ZD mode defined by ZDCTEN, but rather is \"ored\" with it."
      },
      {
        "hi": 10,
        "lo": 10,
        "name": "ZDCTEN",
        "desc": "Causes ZD pin to mirror bit #15 of the active entry in high color table. When ZDCTEN is reset ZD reverts to mirroring color (0)."
      },
      {
        "hi": 9,
        "lo": 9,
        "name": "KILLEHB",
        "desc": "Disables extra halfbrite mode."
      },
      {
        "hi": 8,
        "lo": 8,
        "name": "RDRAM=0",
        "desc": "Causes color table address to read the color table instead of writing to it."
      },
      {
        "hi": 7,
        "lo": 7,
        "name": "SOGEN=0",
        "desc": "When set causes SOG output pin to go high"
      },
      {
        "hi": 6,
        "lo": 6,
        "name": "PF2PRI",
        "desc": "Gives playfield 2 priority over playfield 1."
      },
      {
        "hi": 5,
        "lo": 5,
        "name": "PF2P2",
        "desc": "Playfield 2 (or single playfield) priority code (with resp. to sprites)."
      },
      {
        "hi": 4,
        "lo": 4,
        "name": "PF2P1",
        "desc": ""
      },
      {
        "hi": 3,
        "lo": 3,
        "name": "PF2P0",
        "desc": ""
      },
      {
        "hi": 2,
        "lo": 2,
        "name": "PF1P2",
        "desc": "Playfield 1 priority code (with resp. to sprites)."
      },
      {
        "hi": 1,
        "lo": 1,
        "name": "PF1P1",
        "desc": ""
      },
      {
        "hi": 0,
        "lo": 0,
        "name": "PF1P0",
        "desc": ""
      }
    ]
  },
  "bplcon3": {
    "bits": 16,
    "fields": [
      {
        "hi": 15,
        "lo": 13,
        "name": "BANKx",
        "desc": "Selects one of eight color banks, x = 0-2."
      },
      {
        "hi": 12,
        "lo": 10,
        "name": "PF2OFx",
        "desc": "Determine bit plane color table offset when playfield 2 has priority in dual playfield mode : 000 : none 001 : 2 (plane 2 affected) 010 : 4 (plane 3 affected) 011 : 8 (plane 3 affected) (default) 100 : 16 (plane 5 affected) 101 : 32 (plane 6 affected) 110 : 64 (plane 7 affected) 111 : 128 (plane 8 affected)"
      },
      {
        "hi": 9,
        "lo": 9,
        "name": "LOCT=0",
        "desc": "Dictates that subsequent color palette values will be written to a second 12-bit color palette, constituting the RGB low minus order bits. Writes to the normal hi minus order color palette automattically copied to the low order for backwards compatibility."
      },
      {
        "hi": 7,
        "lo": 6,
        "name": "SPRESx=0",
        "desc": "Determine resolution of all 8 sprites (x = 0,1): 00 : ECS defaults (LORES, HIRES=140ns, SHRES=70ns) 01 : LORES (140ns) 10 : HIRES (70ns) 11 : SHRES (35ns)"
      },
      {
        "hi": 5,
        "lo": 5,
        "name": "BRDRBLNK=0",
        "desc": "\"Border area\" is blanked instead of color (0). Disabled when ECSENA low."
      },
      {
        "hi": 4,
        "lo": 4,
        "name": "BRDNTRAN=0",
        "desc": "\"Border area\" is non minus transparant (ZD pin is low when border is displayed). Disabled when ECSENA low."
      },
      {
        "hi": 2,
        "lo": 2,
        "name": "ZDCLKEN=0",
        "desc": "ZD pin outputs a 14 MHz clock whose falling edge coincides with hires (7 MHz) video data. this bit when set disables all other ZD functions. Disabled when ESCENA low."
      },
      {
        "hi": 1,
        "lo": 1,
        "name": "BRDSPRT=0",
        "desc": "Enables sprites outside the display window. disabled when ESCENA low."
      },
      {
        "hi": 0,
        "lo": 0,
        "name": "EXTBLKEN=0",
        "desc": "Causes BLANK output to be programmable instead of reflecting internal fixed decodes. Disabled when ESCENA low."
      }
    ]
  },
  "bplcon4": {
    "bits": 16,
    "fields": [
      {
        "hi": 15,
        "lo": 8,
        "name": "BPLAMx=0",
        "desc": "This 8 bit field is XOR'ed with the 8 bit plane color address, thereby altering the color address sent to the color table. Default value is 00000000 binary. (x=0-7)"
      },
      {
        "hi": 7,
        "lo": 4,
        "name": "ESPRMx=1",
        "desc": "4 Bit field provides the 4 high order color table address bits for even sprites: SPR0,SPR2,SPR4,SPR6. Default value is 0001 binary. (x=7-4)"
      },
      {
        "hi": 3,
        "lo": 0,
        "name": "OSPRM7=1",
        "desc": "4 Bit field provides the 4 high order color table address bits for odd sprites: SPR1,SPR3,SPR5,SPR7. Default value is 0001 binary. (x=7-4)"
      }
    ]
  },
