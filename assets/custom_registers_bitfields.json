{
  "adkconr": {
    "bits": 16,
    "fields": [
      {
        "hi": 15,
        "lo": 15,
        "name": "SET/CLEAR",
        "desc": "Set/clear control bit.determines if bits written with a 1 get set or cleared.bits written with a zero are always unchanged."
      },
      {
        "hi": 14,
        "lo": 13,
        "name": "PRECOMP 1-0",
        "desc": "00 : none 01 : 140 ns 10 : 280 ns 11 : 560 ns"
      },
      {
        "hi": 12,
        "lo": 12,
        "name": "MFMPREC",
        "desc": "(1 = MFM precomp / 0 = GCR precomp)"
      },
      {
        "hi": 11,
        "lo": 11,
        "name": "UARTBRK",
        "desc": "Forces a UART break (clears TXD) if true"
      },
      {
        "hi": 10,
        "lo": 10,
        "name": "WORDSYNC",
        "desc": "Enables disk read synchronizing on a word equal to DISK SYNC CODE, Located in address DSKSYNC (7E)."
      },
      {
        "hi": 9,
        "lo": 9,
        "name": "MSBSYNC",
        "desc": "Enables disk read synchronizing on the MSB (most significant bit) appl type GCR"
      },
      {
        "hi": 8,
        "lo": 8,
        "name": "FAST",
        "desc": "Disk data clock rate control : 1 : fast(2us) 0 : slow(4us) (Fast for MFM or 2us,slow for 4us GCR)"
      },
      {
        "hi": 7,
        "lo": 7,
        "name": "USE3PN",
        "desc": "Use audio channel 3 to modulate nothing"
      },
      {
        "hi": 6,
        "lo": 6,
        "name": "USE2P3",
        "desc": "Use audio channel 2 to modulate period of channel 3"
      },
      {
        "hi": 5,
        "lo": 5,
        "name": "USE1P2",
        "desc": "Use audio channel 1 to modulate period of channel 2"
      },
      {
        "hi": 4,
        "lo": 4,
        "name": "USE0P1",
        "desc": "Use audio channel 0 to modulate period of channel 1"
      },
      {
        "hi": 3,
        "lo": 3,
        "name": "USE3VN",
        "desc": "Use audio channel 3 to modulate nothing"
      },
      {
        "hi": 2,
        "lo": 2,
        "name": "USE2V3",
        "desc": "Use audio channel 2 to modulate volume of channel 3"
      },
      {
        "hi": 1,
        "lo": 1,
        "name": "USE1V2",
        "desc": "Use audio channel 1 to modulate volume of channel 2"
      },
      {
        "hi": 0,
        "lo": 0,
        "name": "USE0V1",
        "desc": "Use audio channel 0 to modulate volume of channel 1"
      }
    ]
  },
  "audxvol": {
    "bits": 16,
    "fields": [
      {
        "hi": 15,
        "lo": 7,
        "name": "Not used",
        "desc": ""
      },
      {
        "hi": 6,
        "lo": 6,
        "name": "Forces volume to max (64 ones, no zeros)",
        "desc": ""
      },
      {
        "hi": 5,
        "lo": 0,
        "name": "Sets one of the 64 levels (000000 = no output, 111111 = 63 ones, one zero)",
        "desc": ""
      }
    ]
  },
