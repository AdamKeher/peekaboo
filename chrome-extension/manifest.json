{
  "manifest_version": 3,
  "name": "Peekaboo",
  "version": "1.1",
  "description": "Load Amiga releases from demozoo.org, pouet.net, and janeway.exotica.org.uk into the Peekaboo app.",
  "permissions": [],
  "host_permissions": [
    "https://demozoo.org/*",
    "https://www.pouet.net/*",
    "https://janeway.exotica.org.uk/*",
    "http://localhost:7474/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://demozoo.org/productions/*"],
      "js": ["content_scripts/demozoo.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.pouet.net/prod.php*"],
      "js": ["content_scripts/pouet.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://janeway.exotica.org.uk/release.php*"],
      "js": ["content_scripts/janeway.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/icon48.png"],
      "matches": ["https://demozoo.org/*", "https://www.pouet.net/*", "https://janeway.exotica.org.uk/*"]
    }
  ]
}
