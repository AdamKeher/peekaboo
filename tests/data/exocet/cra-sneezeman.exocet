  "manifest": {
    "groups": [
      {"name": "av", "text": "anim_voxel: the flight over the voxel land"},
      {"name": "lst", "text": "large_scroll_twist: the Circumvent twist scroller"},
      {"name": "director", "text": "the disk's cuts"}
    ],
    "tracks": [
      {"name": "av.speed", "group": "av", "type": "int", "min": -255, "max": 255, "default": 80, "text": "the flight along the path, 256ths of a path sample a field", "entries": []},
      {"name": "av.bank", "group": "av", "type": "int", "min": 0, "max": 32, "default": 16, "text": "the bank into the turns, 16ths of the path's", "entries": []},
      {"name": "av.lift", "group": "av", "type": "int", "min": -64, "max": 64, "default": 0, "text": "the camera over the path's height, land levels (the land is 0..63)", "entries": []},
      {"name": "av.look", "group": "av", "type": "int", "min": -512, "max": 511, "default": 0, "text": "the camera turned from the path's heading, 1024ths of a turn", "entries": []},
      {"name": "av.flash", "group": "av", "type": "int", "min": 0, "max": 16, "default": 0, "text": "the land, 0..16 of the way to flash_color", "entries": []},
      {"name": "av.flash_color", "group": "av", "type": "color", "min": 0, "max": 4294967295, "default": 4294967295, "text": "the land's flash; its alpha is how much of it a whole flash is", "entries": []},
      {"name": "av.sky_flash", "group": "av", "type": "int", "min": 0, "max": 16, "default": 0, "text": "the sky behind the land, 0..16 of the way to sky_color", "entries": []},
      {"name": "av.sky_color", "group": "av", "type": "color", "min": 0, "max": 4294967295, "default": 4294967295, "text": "the sky's flash; its alpha is how much of it a whole flash is", "entries": []},
      {"name": "lst.flash", "group": "lst", "type": "int", "min": 0, "max": 16, "default": 0, "text": "background and tile, 0..16 of the way to flash_color", "entries": []},
      {"name": "lst.flash_color", "group": "lst", "type": "color", "min": 0, "max": 4294967295, "default": 4294967295, "text": "the flash's colour; its alpha is how much of it a whole flash is", "entries": []},
      {"name": "lst.twist_speed", "group": "lst", "type": "int", "min": -16, "max": 16, "default": 6, "text": "pixels a frame the twist wave moves; rounded down to even", "entries": []},
      {"name": "lst.rot_speed", "group": "lst", "type": "int", "min": -16, "max": 16, "default": 3, "text": "angle steps a frame the tube turns", "entries": []},
      {"name": "director.cut", "group": "director", "type": "event", "min": -32768, "max": 32767, "default": 0, "text": "the part the disk cuts to, on the row it is keyed or as soon as that part is ready after it", "entries": [{"value": 1, "name": "logo out", "symbol": "CUT_LOGO_OUT"}, {"value": 2, "name": "intro", "symbol": "CUT_INTRO"}, {"value": 3, "name": "loop", "symbol": "CUT_LOOP"}, {"value": 4, "name": "text", "symbol": "CUT_TEXT"}]}
    ],
    "hash": "0x09515221"
  },
